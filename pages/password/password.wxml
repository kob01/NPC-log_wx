<view class="password page-root {{themeClass}}">
  <view class="intro">
    <text class="intro-title">
      {{needOld ? '修改登录密码' : '设置登录密码'}}
    </text>
    <text class="intro-desc">
      设好后可用「{{username}} + 密码」在网页端登录；这个密码不影响微信一键进入。
    </text>
    <text class="intro-desc" wx:if="{{!needOld}}">
      仅用微信注册的账号在设置密码前不能解绑微信，否则就再也登不上了。
    </text>
  </view>

  <view class="card">
    <view class="field" wx:if="{{needOld}}">
      <text class="field-label">当前密码</text>
      <input
        class="field-input"
        password
        placeholder="请输入当前密码"
        value="{{oldPassword}}"
        data-key="oldPassword"
        bindinput="onInput"
      />
    </view>
    <view class="field">
      <text class="field-label">新密码</text>
      <input
        class="field-input"
        password
        placeholder="6-30 位，需同时含字母和数字"
        value="{{password}}"
        data-key="password"
        bindinput="onInput"
      />
    </view>
    <view class="field">
      <text class="field-label">确认新密码</text>
      <input
        class="field-input"
        password
        placeholder="再输入一次新密码"
        value="{{password2}}"
        data-key="password2"
        bindinput="onInput"
      />
    </view>

    <button
      class="btn-primary submit-btn"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="onSubmit"
    >
      {{needOld ? '确认修改' : '确认设置'}}
    </button>
  </view>
</view>
