<view class="profile page-root {{themeClass}}">
  <view class="user-card" bindtap="goAccount">
    <view class="avatar">{{avatarText}}</view>
    <view class="user-info">
      <view class="user-name">{{user.real_name || user.username || '未登录'}}</view>
      <view class="user-sub">
        <text>{{user.username}}</text>
        <view class="tag tag-blue role-tag" wx:if="{{isAdmin}}">管理员</view>
      </view>
    </view>
    <text class="card-arrow">›</text>
  </view>

  <view class="group">
    <view class="cell" bindtap="goReport">
      <view class="cell-left"><text class="cell-title">年度回顾</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="cell" bindtap="goPersons">
      <view class="cell-left"><text class="cell-title">人物图谱</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="cell" bindtap="goOrg">
      <view class="cell-left"><text class="cell-title">我的组织</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="divider"></view>
    <view class="cell" bindtap="goReminders">
      <view class="cell-left">
        <text class="cell-title">定时提醒</text>
        <text class="cell-desc" wx:if="{{remindNeedAuth}}">{{remindNeedAuth}} 条因订阅次数用完被暂停</text>
        <text class="cell-desc" wx:else>到点通过微信服务通知或邮件推送</text>
      </view>
      <view class="tag tag-red" wx:if="{{remindNeedAuth}}">{{remindNeedAuth}}</view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="logout-wrap">
    <button class="btn-ghost logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>
