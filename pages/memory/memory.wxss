.memory {
  min-height: 100vh;
  padding: 20rpx 0 40rpx;
}

.memory .card {
  margin: 0 24rpx 20rpx;
}

/* 搜索结果卡片嵌在白卡内：去掉组件默认左右外边距与阴影，改用浅灰底区分层次 */
.memory .ec-card {
  margin: 0 0 16rpx;
  background: var(--card-sub);
  box-shadow: none;
}

.ask-input {
  width: 100%;
  height: 120rpx;
  padding: 20rpx;
  background: var(--bg);
  border-radius: var(--radius);
  font-size: 28rpx;
  box-sizing: border-box;
}

.ask-btn.btn-primary {
  margin-top: 20rpx;
  margin-right: 0;
  width: 120rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.ask-error {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--danger-weak);
  color: var(--danger);
  border-radius: var(--radius);
  font-size: 24rpx;
}

.ask-answer {
  margin-top: 24rpx;
}

.answer-text {
  padding: 24rpx;
  background: var(--info-bg);
  border-radius: var(--radius);
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-body);
  white-space: pre-wrap;
}

.refs {
  margin-top: 16rpx;
}

.refs-title {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 8rpx;
}

.ref-item {
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid var(--divider);
}

/* 最后一条参考不拖分隔线 */
.ref-item-last {
  border-bottom: none;
}

.ref-time {
  color: var(--text-3);
  margin-right: 12rpx;
}

.ref-event {
  color: var(--primary);
}

.tag-cloud {
  margin-top: 8rpx;
  max-height: 250rpx;
  overflow-y: auto;
}

.link-btn {
  font-size: 26rpx;
  color: var(--primary);
}

.summary-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-body);
  white-space: pre-wrap;
}

.summary-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-4);
}

.search-box {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 8rpx 0 24rpx;
  background: var(--bg);
  border-radius: var(--radius);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-go {
  padding: 10rpx 30rpx;
  background: var(--primary);
  color: var(--text-inv);
  border-radius: var(--radius);
  font-size: 26rpx;
}

.search-count {
  margin: 20rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.load-more {
  text-align: center;
  padding: 20rpx;
  color: var(--primary);
  font-size: 26rpx;
}