.detail {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.gallery {
  width: 100%;
  height: 520rpx;
  background: #000;
}

.gallery-img {
  width: 100%;
  height: 520rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head-time {
  font-size: 24rpx;
  color: #999;
}

.head-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888;
}

.ai-summary {
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}

.ai-tags {
  margin-top: 16rpx;
}

.body-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.loc-name {
  font-size: 30rpx;
  color: #1f1f1f;
}

.loc-addr {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.loc-go {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #1677ff;
}

.link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.link-title {
  flex: 1;
  font-size: 28rpx;
  color: #1677ff;
}

.link-copy {
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
}

.footer {
  display: flex;
  padding: 30rpx 24rpx;
}

.share-row {
  padding: 30rpx 24rpx 0;
}

.footer-btn {
  flex: 1;
  margin: 0 12rpx;
}

.btn-danger {
  background: #fff;
  color: #f5222d;
  border: 1rpx solid #f5222d;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
  text-align: center;
}
