.detail {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.gallery {
  width: 100%;
  height: 520rpx;
  background: #000;
}

.gallery-img {
  width: 100%;
  height: 520rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head-time {
  font-size: 24rpx;
  color: var(--text-3);
  /* 无分类标签时时间仍靠右，与卡片右上角位置保持一致 */
  margin-left: auto;
}

.head-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.ai-summary {
  font-size: 28rpx;
  color: var(--text-body);
  line-height: 1.7;
}

/* 录音回放 */
.audio-row {
  display: flex;
  align-items: center;
}

.audio-btn {
  padding: 10rpx 32rpx;
  border-radius: 40rpx;
  background: var(--primary);
  color: var(--text-inv);
  font-size: 28rpx;
}

.audio-time {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.ai-tags {
  margin-top: 16rpx;
}

.body-text {
  font-size: 30rpx;
  color: var(--text-body);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.loc-name {
  font-size: 30rpx;
  color: var(--text-1);
}

.loc-addr {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.loc-go {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--primary);
}

.link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.link-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--primary);
}

/* 最后一行不再拖一条无意义的分隔线 */
.link-item-last {
  border-bottom: none;
}

.link-copy {
  font-size: 24rpx;
  color: var(--text-3);
  margin-left: 20rpx;
}

.footer {
  display: flex;
  padding: 30rpx 24rpx;
}

.share-row {
  padding: 30rpx 24rpx 0;
}

.footer-btn {
  flex: 1;
  margin: 0 12rpx;
}

/* 单独一行的分享按钮不需要 flex 行内的侧边距，否则与上下卡片左右缘不对齐 */
.share-row .footer-btn {
  margin: 0;
}

.btn-danger {
  background: var(--card);
  color: var(--danger);
  border: 1rpx solid var(--danger);
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
  text-align: center;
}