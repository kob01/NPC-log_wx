.detail {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.gallery {
  width: 100%;
  height: 520rpx;
  background: #000;
}

.gallery-img {
  width: 100%;
  height: 520rpx;
}

.head-row {
  display: flex;
  /* 顶对齐：标题占多行时时间仍贴首行，不随高度居中飘 */
  align-items: flex-start;
}

/* 标题 + 分类标签同处一个流式容器，两者才能同行相接 */
.head-main {
  display: inline-flex;
  flex: 1;
  gap: 16rpx;
  flex-wrap: wrap;
  min-width: 0;
}

.head-title {
  display: inline;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

/* 行内标签：覆盖全局 .tag 的 margin（原本为网格换行留右下边距），改为与标题左侧间距 */
.head-tag {
  /* margin: 0 0 0 12rpx; */
  vertical-align: middle;
}

.head-time {
  /* 不用 space-between + margin-left:auto：靠弹性主轴自然顶到右侧，无标签时位置不变 */
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.ai-summary {
  font-size: 28rpx;
  color: var(--text-body);
  line-height: 1.7;
}

/* 录音回放 */
.audio-row {
  display: flex;
  align-items: center;
}

.audio-btn {
  padding: 10rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--primary);
  color: var(--text-inv);
  font-size: 28rpx;
}

.audio-time {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.ai-tags {
  margin-top: 16rpx;
}

.body-text {
  font-size: 30rpx;
  color: var(--text-body);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.loc-name {
  font-size: 30rpx;
  color: var(--text-1);
}

.loc-addr {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.loc-go {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--primary);
}

.link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.link-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--primary);
}

/* 最后一行不再拖一条无意义的分隔线 */
.link-item-last {
  border-bottom: none;
}

.link-copy {
  font-size: 24rpx;
  color: var(--text-3);
  margin-left: 20rpx;
}

/* 定时提醒入口（整张卡就是按钮，与地点卡同样语义） */
.rm-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rm-entry-text {
  font-size: 28rpx;
  color: var(--text-body);
}

.rm-entry-arrow {
  font-size: 32rpx;
  color: var(--text-3);
  margin-left: 16rpx;
}

.footer {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
  padding: 0 24rpx 0;
}

/* 三个按钮同排：等宽 + 统一高度，避开全局 padding 带来的高低不齐 */
.footer-btn {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  white-space: nowrap;
}

/* 按钮间距不用 gap（旧版内核不支持），改用非首个按钮的 margin-left */
.footer-btn-gap {
  margin-left: 16rpx;
}

.btn-danger {
  background: var(--card);
  color: var(--danger);
  border: 1rpx solid var(--danger);
  border-radius: var(--radius);
  text-align: center;
}