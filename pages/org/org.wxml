<view class="org page-root {{themeClass}}">
  <!-- 顶部标签 -->
  <view class="tabs">
    <view class="tab {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchTab">我的组织</view>
    <view class="tab {{tab === 'square' ? 'active' : ''}}" data-tab="square" bindtap="switchTab">组织广场</view>
    <view class="tab {{tab === 'applications' ? 'active' : ''}}" data-tab="applications" bindtap="switchTab">我的申请</view>
    <view class="tab {{tab === 'records' ? 'active' : ''}}" data-tab="records" bindtap="switchTab">审批结束</view>
    <view class="tab {{tab === 'pending' ? 'active' : ''}}" wx:if="{{canManage || pendingCount}}" data-tab="pending" bindtap="switchTab">
      待审批<text class="badge" wx:if="{{pendingCount}}">{{pendingCount}}</text>
    </view>
  </view>

  <loading wx:if="{{loading}}" />

  <!-- 我的组织 -->
  <block wx:elif="{{tab === 'mine'}}">
    <view class="o-card" wx:for="{{myOrgs}}" wx:key="id">
      <view class="o-head">
        <view class="o-title">
          <text class="o-name ellipsis">{{item.org_name}}</text>
          <text class="o-count">{{item.member_count || 0}} 成员</text>
        </view>
        <view class="tag tag-blue">{{item.roleText}}</view>
      </view>
      <view class="o-desc ellipsis-2" wx:if="{{item.description}}">{{item.description}}</view>
      <!-- 列表只剩已通过的成员（未通过的去「我的申请」看），这行只留别人对我的待审批数 -->
      <view class="o-meta" wx:if="{{item.pending_count > 0}}">
        <text class="red">{{item.pending_count}} 人待审批</text>
      </view>
      <view class="o-meta">
        <text wx:if="{{item.creatorText}}">创建人 {{item.creatorText}}</text>
        <text class="dot" wx:if="{{item.creatorText && item.createdText}}">·</text>
        <text wx:if="{{item.createdText}}">{{item.createdText}}</text>
      </view>
      <view class="o-actions">
        <!-- 名单入口人人都有：管理者在这里升降级/移出成员，普通成员只读名单 -->
        <button class="mini-btn {{item.is_manager === 1 ? 'primary' : 'ghost'}}" wx:if="{{item.my_status === 1}}" data-id="{{item.id}}" bindtap="openMembers">{{item.is_manager === 1 ? '管理' : '成员'}}</button>
        <button class="mini-btn danger" wx:if="{{item.my_status === 1}}" data-id="{{item.id}}" bindtap="onLeave">退出</button>
      </view>
    </view>
    <empty-state wx:if="{{!myOrgs.length}}" text="你还没有加入任何组织，点左下角 + 创建一个" />
    <view class="fab" hover-class="fab-hover" bindtap="openCreate">
      <text class="fab-plus">+</text>
    </view>
  </block>

  <!-- 组织广场 -->
  <block wx:elif="{{tab === 'square'}}">
    <view class="o-card" wx:for="{{square}}" wx:key="id">
      <view class="o-head">
        <view class="o-title">
          <text class="o-name ellipsis">{{item.org_name}}</text>
          <text class="o-count">{{item.member_count || 0}} 成员</text>
        </view>
      </view>
      <view class="o-desc ellipsis-2" wx:if="{{item.description}}">{{item.description}}</view>
      <!-- 成员数已上到标题行，这一行只剩创建人与创建时间，两者都空时不留空行 -->
      <view class="o-meta" wx:if="{{item.creatorText || item.createdText}}">
        <text wx:if="{{item.creatorText}}">创建人 {{item.creatorText}}</text>
        <text class="dot" wx:if="{{item.creatorText && item.createdText}}">·</text>
        <text wx:if="{{item.createdText}}">{{item.createdText}}</text>
      </view>
      <view class="o-actions">
        <button class="mini-btn danger" wx:if="{{item.relation === 'joined'}}" data-id="{{item.id}}" bindtap="onLeave">退出</button>
        <text class="wait-tag" wx:elif="{{item.relation === 'pending'}}">待审批</text>
        <button class="mini-btn primary" wx:else data-id="{{item.id}}" data-name="{{item.org_name}}" bindtap="onApply">申请加入</button>
      </view>
    </view>
    <empty-state wx:if="{{!square.length}}" text="暂无可加入的组织" />
  </block>

  <!-- 我的申请：只装进行中的，已出结果的在「审批结束」 -->
  <block wx:elif="{{tab === 'applications'}}">
    <view class="o-card" wx:for="{{applications}}" wx:key="orgId">
      <view class="o-head">
        <text class="o-name ellipsis">{{item.org_name}}</text>
        <view class="tag tag-orange">{{item.statusText}}</view>
      </view>
      <view class="o-reason" wx:if="{{item.reasonText}}">申请理由：{{item.reasonText}}</view>
      <view class="o-meta">
        <text>{{item.applyText}}</text>
        <text class="hist-link" data-org="{{item.orgId}}" data-user="{{item.userId}}" data-org-name="{{item.org_name}}" data-reason="{{item.reasonText}}" data-apply="{{item.applyText}}" bindtap="openMyApplication">查看记录 ›</text>
      </view>
    </view>
    <empty-state wx:if="{{!applications.length}}" text="没有进行中的申请，已出结果的看「审批结束」" />
  </block>

  <!-- 审批结束：我申请的 + 我管的组织里别人的，已出结果的全在这一列，点开看理由 -->
  <block wx:elif="{{tab === 'records'}}">
    <view class="list-hint" wx:if="{{records.length}}">点卡片可展开申请理由与拒绝理由</view>
    <view class="o-card" wx:for="{{records}}" wx:key="key" data-index="{{index}}" bindtap="openDetail">
      <view class="o-head">
        <text class="o-name ellipsis">{{item.org_name}}</text>
        <view class="tag {{item.ok === 1 ? 'tag-green' : 'tag-red'}}">{{item.resultText}}</view>
      </view>
      <view class="o-meta">
        <text>{{item.directionText}}</text>
        <text class="dot">·</text>
        <!-- 自己申请的那行再打一遍自己的名字纯属噪声 -->
        <text wx:if="{{item.direction === 'org'}}">{{item.nameText}}</text>
        <text class="dot" wx:if="{{item.direction === 'org'}}">·</text>
        <text>{{item.auditText}}</text>
      </view>
    </view>
    <empty-state wx:if="{{!records.length}}" text="还没有已结束的审批记录" />
  </block>

  <!-- 待审批：别人申请我管理的组织 -->
  <block wx:elif="{{tab === 'pending'}}">
    <view class="o-card" wx:for="{{pendingAll}}" wx:key="key">
      <view class="o-head">
        <text class="o-name">申请加入：{{item.org_name}}</text>
      </view>
      <view class="o-meta">
        <text>申请人</text>
        <text class="applicant">{{item.nameText}}</text>
        <text class="hist-link" data-org="{{item.orgId}}" data-user="{{item.userId}}" data-name="{{item.nameText}}" data-org-name="{{item.org_name}}" data-reason="{{item.reasonText}}" data-apply="{{item.applyText}}" bindtap="openPendingHistory">查看记录 ›</text>
      </view>
      <view class="o-reason" wx:if="{{item.reasonText}}">申请理由：{{item.reasonText}}</view>
      <!-- 申请时间挤到操作条左侧：与右侧按钮同排，卡片不会被顶高 -->
      <view class="o-actions">
        <text class="apply-time">{{item.applyText}}</text>
        <button class="mini-btn primary" data-org="{{item.orgId}}" data-user="{{item.userId}}" data-name="{{item.nameText}}" data-approved="1" bindtap="onAuditGlobal">通过</button>
        <button class="mini-btn danger" data-org="{{item.orgId}}" data-user="{{item.userId}}" data-name="{{item.nameText}}" data-approved="0" bindtap="onAuditGlobal">拒绝</button>
      </view>
    </view>
    <empty-state wx:if="{{!pendingAll.length}}" text="没有待审批的申请" />
  </block>

  <!-- 成员名单弹层：待审批只看顶部 tab，这里不再放一份重复的 -->
  <view class="mask" wx:if="{{manageOpen}}" bindtap="closeManage"></view>
  <view class="popup" wx:if="{{manageOpen}}">
    <view class="popup-head">
      <text class="popup-title ellipsis">{{curOrg.is_manager === 1 ? '管理' : '组织成员'}} · {{curOrg.org_name}}</text>
      <text class="popup-close" bindtap="closeManage">✕</text>
    </view>
    <scroll-view class="popup-body" scroll-y>
      <view class="p-row" wx:for="{{members}}" wx:key="id">
        <text class="p-name">{{item.nameText}}<text class="p-role">{{item.roleText}}</text></text>
        <!-- 操作按钮只给管理者：普通成员是看名单，不是管名单 -->
        <view class="p-btns" wx:if="{{curOrg.is_manager === 1}}">
          <text class="p-btn ok" wx:if="{{item.role !== 2 && item.role !== 1}}" data-user="{{item.id}}" data-role="1" bindtap="onSetManager">提升</text>
          <text class="p-btn no" wx:if="{{item.role === 1}}" data-user="{{item.id}}" data-role="0" bindtap="onSetManager">降级</text>
          <text class="p-btn no" wx:if="{{item.canKick === 1}}" data-user="{{item.id}}" data-name="{{item.nameText}}" bindtap="onKick">移出</text>
        </view>
      </view>
      <empty-state wx:if="{{!members.length}}" text="无成员" />
    </scroll-view>
    <!-- 管理者才能改资料 / 解散；启停用不开放，由系统管理员在 Web 端处理 -->
    <view class="popup-foot" wx:if="{{curOrg.is_manager === 1}}">
      <button class="mini-btn primary" bindtap="openEdit">编辑资料</button>
      <button class="mini-btn danger" bindtap="onDismiss">解散组织</button>
    </view>
  </view>

  <!-- 新建 / 编辑组织 -->
  <view class="mask" wx:if="{{formOpen}}" bindtap="closeForm"></view>
  <view class="popup form-pop" wx:if="{{formOpen}}">
    <view class="popup-head">
      <text class="popup-title">{{formId ? '编辑组织' : '创建组织'}}</text>
      <text class="popup-close" bindtap="closeForm">✕</text>
    </view>
    <view class="form-body">
      <view class="f-label">组织名称</view>
      <input
        class="f-input"
        placeholder="请输入组织名称"
        placeholder-class="f-ph"
        maxlength="100"
        value="{{formName}}"
        bindinput="onFormName"
      />
      <view class="f-label">组织描述</view>
      <textarea
        class="f-textarea"
        placeholder="说说这个组织是做什么的（选填）"
        placeholder-class="f-ph"
        maxlength="255"
        value="{{formDesc}}"
        bindinput="onFormDesc"
        auto-height
      ></textarea>
      <view class="f-tip" wx:if="{{!formId}}">创建后你即为该组织的管理者，每人最多创建 5 个</view>
    </view>
    <view class="popup-foot">
      <button class="mini-btn primary" disabled="{{submitting}}" bindtap="submitForm">确定</button>
      <button class="mini-btn ghost" bindtap="closeForm">取消</button>
    </view>
  </view>

  <!-- 审批记录详情：列表只放结论，理由收在这里 -->
  <view class="mask" wx:if="{{detailOpen}}" bindtap="closeDetail"></view>
  <view class="popup" wx:if="{{detailOpen}}">
    <view class="popup-head">
      <text class="popup-title ellipsis">{{detail.org_name}}</text>
      <text class="popup-close" bindtap="closeDetail">✕</text>
    </view>
    <scroll-view class="popup-body" scroll-y>
      <view class="d-row" wx:if="{{detailMode === 'record'}}">
        <text class="d-label">方向</text>
        <text class="d-val">{{detail.directionText}}</text>
      </view>
      <view class="d-row" wx:if="{{detail.nameText}}">
        <text class="d-label">申请人</text>
        <text class="d-val">{{detail.nameText}}</text>
      </view>
      <view class="d-row" wx:if="{{detailMode === 'record'}}">
        <text class="d-label">结果</text>
        <text class="d-val">{{detail.resultText}}</text>
      </view>
      <view class="d-row">
        <text class="d-label">申请时间</text>
        <text class="d-val">{{detail.applyText}}</text>
      </view>
      <view class="d-row" wx:if="{{detail.reasonText}}">
        <text class="d-label">申请理由</text>
        <text class="d-box">{{detail.reasonText}}</text>
      </view>
      <!-- 处理记录时间线：成员行只留最近一轮，多次拒绝/通过都从历史表取，全部列出 -->
      <view class="d-hist-title">
        <text>处理记录</text>
        <text class="d-hint" wx:if="{{historyLoading}}">加载中…</text>
      </view>
      <view class="d-hist" wx:if="{{historyList.length}}">
        <view class="h-item" wx:for="{{historyList}}" wx:key="index">
          <view class="h-head">
            <text class="h-result {{item.ok === 1 ? 'ok' : 'no'}}">{{item.resultText}}</text>
            <text class="h-time">{{item.timeText}}</text>
            <text class="h-auditor" wx:if="{{item.auditorText}}">· {{item.auditorText}}</text>
          </view>
          <view class="h-line" wx:if="{{item.applyReasonText}}">
            <text class="h-cap">申请理由</text>
            <view class="h-reason">{{item.applyReasonText}}</view>
          </view>
          <view class="h-line" wx:if="{{item.reasonText}}">
            <text class="h-cap">{{item.ok === 1 ? '处理说明' : '拒绝理由'}}</text>
            <view class="h-reason {{item.ok === 1 ? '' : 'no'}}">{{item.reasonText}}</view>
          </view>
        </view>
      </view>
      <view class="d-empty" wx:elif="{{!historyLoading}}">暂无处理记录</view>
    </scroll-view>
    <!-- 待审批（管理者）：当场给通过/拒绝；已结束且可重新申请（本人）：给重新申请 -->
    <view class="popup-foot" wx:if="{{detail.canAudit === 1}}">
      <button class="mini-btn primary" data-org="{{detail.orgId}}" data-user="{{detail.userId}}" data-name="{{detail.nameText}}" data-approved="1" bindtap="onAuditGlobal">通过</button>
      <button class="mini-btn danger" data-org="{{detail.orgId}}" data-user="{{detail.userId}}" data-name="{{detail.nameText}}" data-approved="0" bindtap="onAuditGlobal">拒绝</button>
    </view>
    <view class="popup-foot" wx:elif="{{detail.canReapply === 1}}">
      <button class="mini-btn primary" data-id="{{detail.orgId}}" data-name="{{detail.org_name}}" bindtap="onApply">重新申请</button>
    </view>
  </view>
</view>