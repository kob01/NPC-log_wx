.org {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.tabs {
  display: flex;
  background: var(--card);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: var(--text-2);
  position: relative;
}

.tab.active {
  color: var(--primary);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--primary);
  border-radius: 3rpx;
}

.badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
  border-radius: 16rpx;
  background: var(--danger);
  color: var(--text-inv);
  font-size: 20rpx;
  text-align: center;
  /* 默认 baseline 对齐会让红点骑在文字基线上 */
  vertical-align: middle;
}

.o-card {
  background: var(--card);
  border-radius: 18rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
}

.o-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.o-name {
  font-size: 32rpx;
  font-weight: 600;
  max-width: 60%;
}

.o-org {
  font-size: 24rpx;
  color: var(--text-3);
  max-width: 40%;
}

.o-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.o-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.status.ok {
  color: var(--success);
}

.status.wait {
  color: var(--warning);
}

.dot {
  margin: 0 8rpx;
}

.red {
  color: var(--danger);
}

.o-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.mini-btn {
  display: inline-block;
  font-size: 24rpx;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin-left: 16rpx;
  border-radius: 30rpx;
}

.mini-btn.primary {
  background: var(--primary);
  color: var(--text-inv);
}

.mini-btn.danger {
  background: var(--card);
  color: var(--danger);
  border: 1rpx solid var(--danger);
}

.mini-btn::after {
  border: none;
}

.wait-tag {
  font-size: 24rpx;
  color: var(--warning);
  align-self: center;
}

.mask {
  position: fixed;
  /* 不用 inset 简写：部分旧内核不支持，会让遮罩变成 0 尺寸、点外部无法关闭 */
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--mask);
  z-index: 100;
}

.popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70vh;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  /* 内容超高时裁在面板内，不让成员/审批行溢出圆角面板 */
  overflow: hidden;
  /* 底部安全区，避免最后一行成员/审批项落在 Home 条下 */
  padding-bottom: env(safe-area-inset-bottom);
}

.popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
}

.popup-close {
  font-size: 36rpx;
  color: var(--text-3);
}

.popup-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--divider);
}

.ptab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-2);
}

.ptab.active {
  color: var(--primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--primary);
}

.popup-body {
  flex: 1;
  /* scroll-view 在 flex 列里需要明确可收缩，否则高度塌陷不滚动或溢出面板 */
  min-height: 0;
  padding: 0 28rpx;
}

.p-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.p-name {
  font-size: 28rpx;
  /* 长用户名+真名不撑开整行，把右侧按钮顶出屏幕 */
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.p-role {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.p-btns {
  display: flex;
  flex-shrink: 0;
}

.p-btn {
  font-size: 24rpx;
  padding: 6rpx 22rpx;
  margin-left: 16rpx;
  border-radius: 24rpx;
}

.p-btn.ok {
  background: var(--primary);
  color: var(--text-inv);
}

.p-btn.no {
  background: var(--card);
  color: var(--danger);
  border: 1rpx solid var(--danger);
}