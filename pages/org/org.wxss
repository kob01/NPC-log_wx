.org {
  min-height: 100vh;
  /* 给左下角的悬浮 + 按钮留出位置，不然最后一张卡片会被盖住 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.tabs {
  display: flex;
  background: var(--card);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: var(--text-2);
  position: relative;
}

.tab.active {
  color: var(--primary);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: var(--primary);
  border-radius: var(--radius-pill);
}

.badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
  border-radius: var(--radius-pill);
  background: var(--danger);
  color: var(--text-inv);
  font-size: 20rpx;
  text-align: center;
  /* 默认 baseline 对齐会让红点骑在文字基线上 */
  vertical-align: middle;
}

.o-card {
  background: var(--card);
  border-radius: var(--radius);
  margin: 20rpx 24rpx;
  padding: 24rpx;
}

.o-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 名称与成员数同排：名称占满剩余宽度并负责省略，成员数靠右不参与压缩 */
.o-title {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}

.o-name {
  font-size: 32rpx;
  font-weight: 600;
  min-width: 0;
}

.o-count {
  flex-shrink: 0;
  margin-left: 14rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.o-head .tag {
  flex-shrink: 0;
  margin-bottom: 0;
}

.o-org {
  font-size: 24rpx;
  color: var(--text-3);
  max-width: 40%;
}

.o-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.o-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.status.wait {
  color: var(--warning);
}

/* 待审批卡片里申请人是一眼要看的信息，比同排的时间重一档 */
.applicant {
  margin-left: 8rpx;
  color: var(--text-1);
  font-weight: 600;
}

.dot {
  margin: 0 8rpx;
}

.red {
  color: var(--danger);
}

.o-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.mini-btn {
  width: 200rpx;
  display: inline-block;
  font-size: 24rpx;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin-left: 16rpx;
  border-radius: var(--radius);
}

.o-actions .mini-btn {
  width: 160rpx;
  margin-left: 0;
  margin-right: 0;
}

/* 申请时间占住行首：margin-right: auto 把它顶到左下角，按钮仍靠右 */
.apply-time {
  align-self: center;
  margin-right: auto;
  font-size: 24rpx;
  color: var(--text-3);
}

.mini-btn.primary {
  background: var(--primary);
  color: var(--text-inv);
}

.mini-btn.danger {
  background: var(--card);
  color: var(--danger);
  border: 1rpx solid var(--danger);
}

.mini-btn::after {
  border: none;
}

.wait-tag {
  font-size: 24rpx;
  color: var(--warning);
  align-self: center;
}

.mask {
  position: fixed;
  /* 不用 inset 简写：部分旧内核不支持，会让遮罩变成 0 尺寸、点外部无法关闭 */
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: var(--mask);
  z-index: 100;
}

.popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70vh;
  background: var(--card);
  border-radius: var(--radius) var(--radius) 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
  /* 内容超高时裁在面板内，不让成员/审批行溢出圆角面板 */
  overflow: hidden;
  /* 底部安全区，避免最后一行成员/审批项落在 Home 条下 */
  padding-bottom: env(safe-area-inset-bottom);
}

.popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
}

.popup-close {
  font-size: 36rpx;
  color: var(--text-3);
}

.popup-body {
  flex: 1;
  box-sizing: border-box;
  min-height: 0;
  padding: 0 28rpx;
}

.p-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.p-name {
  font-size: 28rpx;
  /* 长用户名+真名不撑开整行，把右侧按钮顶出屏幕 */
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.p-role {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.p-btns {
  display: flex;
  flex-shrink: 0;
}

.p-btn {
  font-size: 24rpx;
  padding: 6rpx 22rpx;
  margin-left: 16rpx;
  border-radius: var(--radius-pill);
}

.p-btn.ok {
  background: var(--primary);
  color: var(--text-inv);
}

.p-btn.no {
  background: var(--card);
  color: var(--danger);
  border: 1rpx solid var(--danger);
}

/* ==================== 创建 / 编辑组织 ==================== */

/* 创建组织：固定在屏幕左下角的悬浮按钮 */
.fab {
  position: fixed;
  left: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 20;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--primary);
  color: var(--text-inv);
  display: flex;
  align-items: center;
  justify-content: center;
  /* --shadow 存的是完整 box-shadow 值，FAB 需要更重一点的投影所以直接写 */
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}

.fab-hover {
  opacity: 0.85;
}

/* “+” 字形偏上，行高收紧后才能视觉居中 */
.fab-plus {
  font-size: 60rpx;
  font-weight: 300;
  line-height: 64rpx;
}

/* 弹层底部操作条：管理面板的「编辑资料 / 解散组织」与表单的「确定 / 取消」共用 */
.popup-foot {
  display: flex;
  gap: 28rpx;
  align-items: center;
  justify-content: flex-end;
  padding: 28rpx;
  border-top: 1rpx solid var(--divider);
}

.mini-btn.ghost {
  background: var(--card);
  color: var(--text-2);
  border: 1rpx solid var(--divider);
}

.mini-btn[disabled] {
  opacity: 0.6;
}

/* 表单面板不需要 70vh 的空壳高度，按内容开 */
.form-pop {
  height: auto;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.form-body {
  padding: 0 28rpx 8rpx;
}

.f-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin: 20rpx 0 10rpx;
}

.f-input,
.f-textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: var(--bg);
  border: 1rpx solid var(--divider);
  border-radius: var(--radius);
}

/* input 自带固定原生高度（1.4rem），border-box 下再加上下 padding 会把行高挤裁（占位符上下一半看不见），
   只能像 password 页那样用 height 撑开，上下交给居中对齐 */
.f-input {
  height: 76rpx;
}

.f-textarea {
  min-height: 120rpx;
  padding: 16rpx 20rpx;
}

.f-ph {
  color: var(--text-3);
}

.f-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* ==================== 申请与审批记录 ==================== */

/* 理由单独一行（卡片里用），.no 是拒绝理由，要用危险色提醒 */
.o-reason {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
  word-break: break-all;
}

.o-reason.no {
  color: var(--danger);
}

/* 列表顶部的一行操作提示：审批结束要点卡片才能看到理由，不提示没人知道能点 */
.list-hint {
  margin: 20rpx 24rpx 0;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 记录详情的「标签 + 内容」行 */
.d-row {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.d-label {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-3);
}

.d-val {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-1);
  word-break: break-all;
}

/* 理由单独包一块底色，与上面的普通字段区分开 */
.d-box {
  flex: 1;
  min-width: 0;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--bg);
  border-radius: var(--radius);
  word-break: break-all;
}

.d-box.no {
  color: var(--danger);
}