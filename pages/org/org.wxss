.org {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #1677ff;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #1677ff;
  border-radius: 3rpx;
}

.badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
  border-radius: 16rpx;
  background: #f5222d;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}

.o-card {
  background: #fff;
  border-radius: 18rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
}

.o-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.o-name {
  font-size: 32rpx;
  font-weight: 600;
  max-width: 60%;
}

.o-org {
  font-size: 24rpx;
  color: #999;
  max-width: 40%;
}

.o-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #666;
}

.o-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.status.ok {
  color: #52c41a;
}

.status.wait {
  color: #fa8c16;
}

.dot {
  margin: 0 8rpx;
}

.red {
  color: #f5222d;
}

.o-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.mini-btn {
  display: inline-block;
  font-size: 24rpx;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin-left: 16rpx;
  border-radius: 30rpx;
}

.mini-btn.primary {
  background: #1677ff;
  color: #fff;
}

.mini-btn.danger {
  background: #fff;
  color: #f5222d;
  border: 1rpx solid #ffa39e;
}

.mini-btn::after {
  border: none;
}

.wait-tag {
  font-size: 24rpx;
  color: #fa8c16;
  align-self: center;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
}

.popup-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
}

.popup-close {
  font-size: 36rpx;
  color: #999;
}

.popup-tabs {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.ptab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
}

.ptab.active {
  color: #1677ff;
  font-weight: 600;
  border-bottom: 4rpx solid #1677ff;
}

.popup-body {
  flex: 1;
  padding: 0 28rpx;
}

.p-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.p-name {
  font-size: 28rpx;
}

.p-role {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.p-btns {
  display: flex;
}

.p-btn {
  font-size: 24rpx;
  padding: 6rpx 22rpx;
  margin-left: 16rpx;
  border-radius: 24rpx;
}

.p-btn.ok {
  background: #1677ff;
  color: #fff;
}

.p-btn.no {
  background: #fff;
  color: #f5222d;
  border: 1rpx solid #ffa39e;
}
