<view class="timeline">
  <!-- 搜索：收起为图标，点击展开为输入框 -->
  <view class="search-bar">
    <view class="search-box" wx:if="{{searchExpanded}}">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索你的日志（AI 记忆检索）"
        confirm-type="search"
        focus="{{searchExpanded}}"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
        bindblur="collapseSearch"
      />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClear">✕</text>
    </view>
    <view class="search-collapsed" wx:else bindtap="expandSearch">
      <text class="search-icon">🔍</text>
      <text class="search-hint">搜索日志</text>
    </view>
  </view>

  <block wx:if="{{groups.length}}">
    <view class="group" wx:for="{{groups}}" wx:key="day" wx:for-item="group">
      <view class="day-head">
        <text class="day-pill">{{group.day}}</text>
      </view>
      <event-card
        wx:for="{{group.items}}"
        wx:key="id"
        wx:for-item="item"
        entry="{{item}}"
        show-score="{{searchMode}}"
        bind:select="goDetail"
      />
    </view>
  </block>

  <empty-state
    wx:elif="{{!loading}}"
    text="{{searchMode ? '没有找到相关日志' : '还没有日志，点右下角记录第一条'}}"
  />

  <loading wx:if="{{loading}}" text="{{searchMode ? '检索中' : '加载中'}}" />
  <view class="no-more" wx:if="{{!loading && !hasMore && !searchMode && entries.length}}">
    — 没有更多了 —
  </view>

  <!-- 悬浮按钮：＋ 写日志 / 🎙 长按录音 -->
  <block wx:if="{{!searchMode}}">
    <view class="fab fab-mic" bindtouchstart="onMicStart" bindtouchend="onMicEnd" bindtouchcancel="onMicEnd">🎙</view>
    <view class="fab" bindtap="goEdit">＋</view>
  </block>

  <!-- 录音波纹浮层 -->
  <view class="record-mask" wx:if="{{recording}}" catchtouchmove="noop">
    <view class="ripple-wrap">
      <view class="ripple r1"></view>
      <view class="ripple r2"></view>
      <view class="ripple r3"></view>
      <view class="mic-core">🎙</view>
    </view>
    <view class="record-time">{{recordSeconds}}″</view>
    <view class="record-text">{{liveText || '请说出这段日志…'}}</view>
    <view class="record-hint">松开发送 · 最长 60 秒</view>
  </view>
</view>
