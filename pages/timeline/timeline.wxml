<view class="timeline page-root {{themeClass}}">
  <!-- 顶部：展开为搜索框；收起时右侧并排「搜索图标 + 新增」 -->
  <view class="search-bar">
    <view class="search-box" wx:if="{{searchExpanded}}">
      <image
        class="search-glyph"
        mode="aspectFit"
        src="data:image/svg+xml;base64,"
      />
      <input
        class="search-input"
        placeholder="搜索你的日志（AI 记忆检索）"
        confirm-type="search"
        focus="{{searchExpanded}}"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
        bindblur="collapseSearch"
      />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClear">✕</text>
    </view>
    <view class="top-bar" wx:else>
      <view class="search-collapsed" bindtap="expandSearch">
        <image
          class="search-glyph"
          mode="aspectFit"
          src="data:image/svg+xml;base64,"
        />
      </view>
      <view class="add-btn" bindtap="goEdit">
        <image
          class="add-glyph"
          mode="aspectFit"
          src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgdmlld0JveD0iMCAwIDI0IDI0IiBmaWxsPSJub25lIiBzdHJva2U9IiNmZmZmZmYiIHN0cm9rZS13aWR0aD0iMiIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIj48cGF0aCBkPSJNMTIgNXYxNE01IDEyaDE0Ii8+PC9zdmc+"
        />
      </view>
    </view>
  </view>

  <block wx:if="{{groups.length}}">
    <view class="tl-body {{sheetVisible ? 'tl-body-shrunk' : ''}}">
      <view class="tl-line"></view>
      <view class="group" wx:for="{{groups}}" wx:key="month" wx:for-item="group">
        <view class="tl-month">
          <view class="tl-month-pill">{{group.label}}</view>
        </view>
        <view
          class="tl-row {{item.first ? 'tl-row-first' : ''}}"
          wx:for="{{group.items}}"
          wx:key="id"
        >
          <view class="tl-dot"></view>
          <event-card
            entry="{{item}}"
            show-score="{{searchMode}}"
            bind:select="goDetail"
          />
        </view>
      </view>
    </view>
  </block>

  <empty-state
    wx:elif="{{!loading}}"
    text="{{searchMode ? '没有找到相关日志' : '还没有日志，点右下角记录第一条'}}"
  />

  <loading wx:if="{{loading}}" text="{{searchMode ? '检索中' : '加载中'}}" />
  <view class="no-more" wx:if="{{!loading && !hasMore && !searchMode && entries.length}}">
    — 没有更多了 —
  </view>

  <!-- 底部录音按钮：按住 → 圆形扩大成底部面板；松手发送，左滑到最左侧 ✕ 取消
       touchmove 必须留在按钮上（手势自 touchstart 起就锁定该节点），且用 catch 挡住页面滚动 -->
  <view
    class="fab {{sheetVisible ? 'fab-hidden' : ''}}"
    wx:if="{{!searchMode}}"
    bindtouchstart="onMicStart"
    catchtouchmove="onMicMove"
    bindtouchend="onMicEnd"
    bindtouchcancel="onMicEnd"
  >🎙</view>

  <!-- 录音时只压暗列表，界面不再被全屏遮罩接管 -->
  <view class="record-veil" wx:if="{{sheetVisible}}" catchtouchmove="noop"></view>

  <!-- 录音面板：起点与按钮重合的圆，置 recording 后过渡成底部约 1/3 屏的方形 -->
  <view
    class="record-sheet {{recording ? 'open' : ''}} {{canceling ? 'canceling' : ''}}"
    wx:if="{{sheetVisible}}"
    style="{{recording ? sheetStyleOpen : sheetStyleClosed}}"
    catchtouchmove="noop"
  >
    <!-- 左滑命中区：整条左侧竖带都算取消，故判定只看横坐标 -->
    <view class="sheet-cancel">
      <view class="cancel-label">{{canceling ? '松开取消' : '左滑取消'}}</view>
      <view class="cancel-icon">✕</view>
    </view>

    <view class="sheet-main">
      <view class="sheet-status">
        <view class="rec-dot"></view>
        <text class="sheet-time">{{recordTimeText}}</text>
        <text class="sheet-limit" wx:if="{{recordSeconds >= recordMax - 10}}">剩 {{recordMax - recordSeconds}}″</text>
      </view>

      <!-- 波形：每根条子的基准高度/延迟/周期在 onLoad 生成一次，之后纯 CSS 抖动 -->
      <view class="wave">
        <view
          class="wave-bar"
          wx:for="{{waveBars}}"
          wx:key="id"
          style="{{item.style}}"
        ></view>
      </view>

      <view class="sheet-hint">{{cancelHint}}</view>
    </view>
  </view>
</view>
