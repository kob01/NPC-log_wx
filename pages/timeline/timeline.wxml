<view class="timeline page-root {{themeClass}}">
  <!-- 顶部：展开为搜索框；收起时右侧并排「搜索图标 + 新增」 -->
  <view class="search-bar">
    <view class="search-box" wx:if="{{searchExpanded}}">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索你的日志（AI 记忆检索）"
        confirm-type="search"
        focus="{{searchExpanded}}"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
        bindblur="collapseSearch"
      />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClear">✕</text>
    </view>
    <view class="top-bar" wx:else>
      <view class="search-collapsed" bindtap="expandSearch"><text class="search-icon">🔍</text></view>
      <view class="add-btn" bindtap="goEdit">＋</view>
    </view>
  </view>

  <block wx:if="{{groups.length}}">
    <view class="tl-body">
      <view class="tl-line"></view>
      <view class="group" wx:for="{{groups}}" wx:key="month" wx:for-item="group">
        <view class="tl-month">
          <view class="tl-month-pill">{{group.label}}</view>
        </view>
        <view
          class="tl-row {{item.first ? 'tl-row-first' : ''}}"
          wx:for="{{group.items}}"
          wx:key="id"
        >
          <view class="tl-dot"></view>
          <event-card
            entry="{{item}}"
            show-score="{{searchMode}}"
            bind:select="goDetail"
          />
        </view>
      </view>
    </view>
  </block>

  <empty-state
    wx:elif="{{!loading}}"
    text="{{searchMode ? '没有找到相关日志' : '还没有日志，点右下角记录第一条'}}"
  />

  <loading wx:if="{{loading}}" text="{{searchMode ? '检索中' : '加载中'}}" />
  <view class="no-more" wx:if="{{!loading && !hasMore && !searchMode && entries.length}}">
    — 没有更多了 —
  </view>

  <!-- 底部录音悬浮按钮：按住录音，松开发送 -->
  <view
    class="fab"
    wx:if="{{!searchMode}}"
    bindtouchstart="onMicStart"
    bindtouchend="onMicEnd"
    bindtouchcancel="onMicEnd"
  >🎙</view>

  <!-- 录音波纹浮层 -->
  <view class="record-mask" wx:if="{{recording}}" catchtouchmove="noop">
    <view class="ripple-wrap">
      <view class="ripple r1"></view>
      <view class="ripple r2"></view>
      <view class="ripple r3"></view>
      <view class="mic-core">🎙</view>
    </view>
    <view class="record-time">{{recordSeconds}}″</view>
    <view class="record-text">请说出这段日志…</view>
    <view class="record-hint">松开发送 · 最长 60 秒</view>
  </view>
</view>
