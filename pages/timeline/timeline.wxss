.timeline {
    /* position: relative; */
    min-height: 100vh;
    /* 预留顶部悬浮栏高度，避免首条被遮挡 */
    padding: 0;
}

.search-bar {
    /* 绝对定位：整行悬浮于列表之上，不占据列表位置 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    /* 低于录音浮层(15)，录音时不抢在遮罩之上 */
    padding: 12rpx 24rpx;
    background: transparent;
}

.search-box {
    display: flex;
    align-items: center;
    height: 72rpx;
    padding: 0 24rpx;
    background: var(--card);
    border-radius: 40rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.search-icon {
    font-size: 26rpx;
    margin-right: 12rpx;
    opacity: 0.5;
}

.search-input {
    flex: 1;
    font-size: 28rpx;
}

.search-clear {
    font-size: 26rpx;
    color: var(--text-4);
    padding: 0 8rpx;
}

.search-collapsed {
    display: flex;
    align-items: center;
    height: 56rpx;
    padding: 0 18rpx;
    border-radius: 30rpx;
    background: var(--card);
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.top-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 72rpx;
}

.add-btn {
    display: flex;
    align-items: center;
    height: 56rpx;
    padding: 0 18rpx;
    margin-left: 16rpx;
    border-radius: 30rpx;
    background: var(--primary);
    color: var(--text-inv);
    font-size: 30rpx;
}

.search-hint {
    font-size: 26rpx;
    color: var(--text-3);
    margin-left: 8rpx;
}

/* ==================== 左侧竖向时间轴 ==================== */
.tl-body {
    position: relative;
    /* 底部不留 padding：末行卡片的 margin 会塌陷到容器外，竖线不再多出一截尾巴 */
    padding: 8rpx 0 0;
}

/* 贯穿上下的竖线（与圆点中心对齐于 39rpx） */
.tl-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 37rpx;
    width: 4rpx;
    background: var(--border-2);
}

.group {
    position: relative;
}

/* 月份分割标题：滚动时 sticky 悬浮在左上角 */
.tl-month {
    position: sticky;
    /* 顶部 .search-bar 为 fixed，高 20+72+20=112rpx，悬浮位置需避开它，否则胶囊会被搜索栏压住 */
    top: 0;
    /* 低于顶部搜索栏(10)与录音浮层(15) */
    z-index: 6;
    /* 左距 72rpx 与卡片左边缘齐平，同时避开 39rpx 处的竖线；上边距留小量，避免胶囊紧贴搜索栏底边 */
    padding: 12rpx 24rpx 16rpx 72rpx;
}

/* 圆角胶囊底：卡片从下方滚过时不透字；颜色跟 --card，深色模式自动生效 */
.tl-month-pill {
    display: inline-block;
    font-size: 32rpx;
    font-weight: 600;
    color: var(--primary);
    /* 与页面同底色，卡片从其下方滚过时文字仍清晰 */
    background: transparent;
}

/* 卡片行：左侧留出轨道区，竖线/圆点中心 39rpx，首行稍离月份标题 */
.tl-row {
    position: relative;
    padding-left: 72rpx;
}

.tl-row-first {
    padding-top: 8rpx;
}

/* 组件默认外边距会挤压卡片宽度，时间轴布局下由行容器接管左距 */
.tl-row .ec-card {
    margin: 0 24rpx 20rpx 0;
}

/* 圆点骑在竖线上，对齐卡片头部（右上角时间一行）的高度 */
.tl-dot {
    position: absolute;
    left: 28rpx;
    top: 32rpx;
    width: 22rpx;
    height: 22rpx;
    box-sizing: border-box;
    border-radius: 50%;
    background: var(--card);
    border: 6rpx solid var(--primary);
    z-index: 1;
}

.no-more {
    text-align: center;
    color: var(--text-4);
    font-size: 24rpx;
    padding: 30rpx 0;
}

.fab {
    position: fixed;
    right: 40rpx;
    bottom: 60rpx;
    width: 100rpx;
    height: 100rpx;
    line-height: 96rpx;
    text-align: center;
    border-radius: 50%;
    background: var(--primary);
    color: var(--text-inv);
    font-size: 60rpx;
    box-shadow: 0 6rpx 20rpx rgba(22, 119, 255, 0.4);
    z-index: 20;
}

/* ==================== 录音波纹浮层（固定深色遮罩，不随主题变化） ==================== */
.record-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    /* 低于 .fab(20)：按住时按钮始终在顶层，不被浮层打断 touch 序列 */
    z-index: 15;
    background: rgba(0, 0, 0, 0.85);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 60rpx;
}

.ripple-wrap {
    position: relative;
    width: 240rpx;
    height: 240rpx;
}

.ripple {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    border-radius: 50%;
    border: 2rpx solid rgba(22, 119, 255, 0.7);
    background: rgba(22, 119, 255, 0.18);
    animation: ripple 1.8s ease-out infinite;
}

.r2 {
    animation-delay: 0.6s;
}

.r3 {
    animation-delay: 1.2s;
}

@keyframes ripple {
    0% {
        transform: scale(0.55);
        opacity: 0.9;
    }

    100% {
        transform: scale(1.5);
        opacity: 0;
    }
}

.mic-core {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 140rpx;
    height: 140rpx;
    line-height: 140rpx;
    text-align: center;
    border-radius: 50%;
    background: #1677ff;
    color: #fff;
    font-size: 60rpx;
    box-shadow: 0 0 40rpx rgba(22, 119, 255, 0.8);
}

.record-time {
    margin-top: 48rpx;
    color: #fff;
    font-size: 40rpx;
    font-weight: 600;
}

.record-text {
    margin-top: 24rpx;
    max-height: 240rpx;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.85);
    font-size: 30rpx;
    line-height: 1.7;
    text-align: center;
}

.record-hint {
    margin-top: 40rpx;
    color: rgba(255, 255, 255, 0.45);
    font-size: 24rpx;
}

@import 'timeline-wxa-auto-dark.wxss'