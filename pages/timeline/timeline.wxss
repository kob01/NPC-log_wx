.timeline {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 20rpx 24rpx;
  background: #f5f6f8;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 40rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  font-size: 26rpx;
  color: #bbb;
  padding: 0 8rpx;
}

.search-collapsed {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 72rpx;
  padding: 0 8rpx;
}

.search-hint {
  font-size: 26rpx;
  color: #999;
  margin-left: 8rpx;
}

.day-head {
  text-align: center;
  padding: 16rpx 0;
}

.day-pill {
  display: inline-block;
  padding: 4rpx 24rpx;
  border-radius: 30rpx;
  background: #e8e8e8;
  color: #666;
  font-size: 22rpx;
}

.no-more {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 30rpx 0;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: #1677ff;
  color: #fff;
  font-size: 60rpx;
  box-shadow: 0 6rpx 20rpx rgba(22, 119, 255, 0.4);
  z-index: 20;
}

.fab-mic {
  right: 176rpx;
  background: #fff;
  color: #1677ff;
  font-size: 48rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
}

/* ==================== 录音波纹浮层 ==================== */
.record-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.ripple-wrap {
  position: relative;
  width: 240rpx;
  height: 240rpx;
}

.ripple {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(22, 119, 255, 0.7);
  background: rgba(22, 119, 255, 0.18);
  animation: ripple 1.8s ease-out infinite;
}

.r2 {
  animation-delay: 0.6s;
}

.r3 {
  animation-delay: 1.2s;
}

@keyframes ripple {
  0% {
    transform: scale(0.55);
    opacity: 0.9;
  }

  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

.mic-core {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  border-radius: 50%;
  background: #1677ff;
  color: #fff;
  font-size: 60rpx;
  box-shadow: 0 0 40rpx rgba(22, 119, 255, 0.8);
}

.record-time {
  margin-top: 48rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}

.record-text {
  margin-top: 24rpx;
  max-height: 240rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.85);
  font-size: 30rpx;
  line-height: 1.7;
  text-align: center;
}

.record-hint {
  margin-top: 40rpx;
  color: rgba(255, 255, 255, 0.45);
  font-size: 24rpx;
}
