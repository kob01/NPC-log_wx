.timeline {
    /* position: relative; */
    min-height: 100vh;
    padding: 0;
}

.search-bar {
    /* 绝对定位：整行悬浮于列表之上，不占据列表位置 */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    /* 低于录音遮罩(18)，录音时不抢在遮罩之上 */
    padding: 12rpx 24rpx;
    background: transparent;
}

.search-box {
    display: flex;
    align-items: center;
    height: 72rpx;
    padding: 0 24rpx;
    background: var(--card);
    border-radius: var(--radius-pill);
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 展开态搜索框内的放大镜：SVG 自身已是灰色，不再叠加 opacity；不参与伸缩以免被输入框挤扁 */
.search-box .search-glyph {
    margin-right: 12rpx;
    flex-shrink: 0;
}

.search-input {
    flex: 1;
    font-size: 28rpx;
}

.search-clear {
    font-size: 26rpx;
    color: var(--text-4);
    padding: 0 8rpx;
}

.search-collapsed {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56rpx;
    height: 56rpx;
    padding: 0;
    border-radius: var(--radius-pill);
    background: var(--card);
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.search-glyph {
    width: 32rpx;
    height: 32rpx;
}

.top-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 72rpx;
}

/* 右侧图标组：搜索 + 查看范围 + 新增 */
.top-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
}

/* 「查看范围」循环按钮（四态）：与搜索按钮同构（白底圆），置于搜索与 + 之间 */
.mine-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56rpx;
    height: 56rpx;
    padding: 0;
    margin-left: 16rpx;
    border-radius: var(--radius-pill);
    background: var(--card);
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

/* 开启态：图标转蓝 + 淡蓝底，低存在感地表示筛选生效 */
.mine-btn-on {
    background: rgba(22, 119, 255, 0.12);
    box-shadow: none;
}

.mine-glyph {
    width: 32rpx;
    height: 32rpx;
}

/* 顶部三分之一处的轻提示：半透明深色胶囊居中，pointer-events 不挡交互 */
.top-hint {
    position: fixed;
    top: 40rpx;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 30;
    max-width: 70%;
    padding: 16rpx 30rpx;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 28rpx;
    line-height: 1.4;
    text-align: center;
    pointer-events: none;
}

.add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56rpx;
    height: 56rpx;
    padding: 0;
    margin-left: 16rpx;
    border-radius: var(--radius-pill);
    background: var(--primary);
}

.add-glyph {
    width: 32rpx;
    height: 32rpx;
}

.search-hint {
    font-size: 26rpx;
    color: var(--text-3);
    margin-left: 8rpx;
}

/* ==================== 左侧竖向时间轴 ==================== */
.tl-body {
    position: relative;
    /* 底部不留 padding：末行卡片的 margin 会塌陷到容器外，竖线不再多出一截尾巴 */
    padding: 8rpx 0 0;
    transition: opacity 0.32s ease, transform 0.32s ease;
}

/* 录音时列表整体后退缩小，与底部面板拉开主次（只作用于列表，
   不碰页面根节点：根节点一旦带 transform，内部 fixed 元素会跟着被缩放） */
.tl-body-shrunk {
    opacity: 0.6;
    transform: scale(0.96) translateY(-8rpx);
}

/* 贯穿上下的竖线（与圆点中心对齐于 39rpx） */
.tl-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 37rpx;
    width: 4rpx;
    background: var(--border-2);
}

.group {
    position: relative;
}

/* 月份分割标题：滚动时 sticky 悬浮在左上角 */
.tl-month {
    position: sticky;
    /* 顶部 .search-bar 为 fixed，高 20+72+20=112rpx，悬浮位置需避开它，否则胶囊会被搜索栏压住 */
    top: 0;
    /* 低于顶部搜索栏(10)与录音遮罩(18)/面板(19) */
    z-index: 6;
    /* 左距 72rpx 与卡片左边缘齐平，同时避开 39rpx 处的竖线；上边距留小量，避免胶囊紧贴搜索栏底边 */
    padding: 12rpx 24rpx 16rpx 72rpx;
}

/* 圆角胶囊底：卡片从下方滚过时不透字；颜色跟 --card，深色模式自动生效 */
.tl-month-pill {
    display: inline-block;
    font-size: 32rpx;
    font-weight: 600;
    color: var(--primary);
    /* 与页面同底色，卡片从其下方滚过时文字仍清晰 */
    background: transparent;
}

/* 卡片行：左侧留出轨道区，竖线/圆点中心 39rpx，首行稍离月份标题 */
.tl-row {
    position: relative;
    padding-left: 72rpx;
}

.tl-row-first {
    padding-top: 8rpx;
}

/* 组件默认外边距会挤压卡片宽度，时间轴布局下由行容器接管左距 */
.tl-row .ec-card {
    margin: 0 24rpx 20rpx 0;
}

/* 圆点骑在竖线上，对齐卡片头部（右上角时间一行）的高度 */
.tl-dot {
    position: absolute;
    left: 28rpx;
    top: 32rpx;
    width: 22rpx;
    height: 22rpx;
    box-sizing: border-box;
    border-radius: 50%;
    background: var(--card);
    border: 6rpx solid var(--primary);
    z-index: 1;
}

/* ==================== 置顶区（我自己钉的那几条，单独一节放在最上方） ==================== */
.tl-pinned {
    position: relative;
}

/* 节标题：比月份胶囊小一号、取橙色而不是主题蓝 —— 两者同形同色就会分不清
   「这是一月的开始」还是「这是置顶」；橙色在卡片上又不与已有的三个 tag 色相碍 */
.tl-pinned-head {
    padding: 12rpx 24rpx 12rpx 72rpx;
    font-size: 22rpx;
    color: var(--warning);
}

/* 置顶行的圆点只换色不加图：整条时间轴的几何（中心 39rpx）跟着卡片一起复用 */
.tl-dot-pinned {
    border-color: var(--warning);
}

.no-more {
    text-align: center;
    color: var(--text-4);
    font-size: 24rpx;
    padding: 30rpx 0;
}

.fab {
    position: fixed;
    right: 70rpx;
    bottom: 40rpx;
    width: 90rpx;
    height: 90rpx;
    /* 图标是 <image> 节点，靠 flex 居中（原先的 line-height + text-align 只服务 emoji 文字） */
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 6rpx 20rpx rgba(22, 119, 255, 0.4);
    z-index: 20;
    /* 面板展开时按钮只淡出：不能 display:none / visibility:hidden，
       否则本手势后续的 touchmove 拿不到节点，上滑取消就失效 */
    transition: opacity 0.2s ease;
}

/* 经典话筒（iconfont/AntD 导出，1024 viewBox）：base64 SVG，白色写死在 path 上
   （iconfont 原本靠 fill: currentColor 取色，<image> 不继承 CSS 色，不改就会渲染成黑色）
   注：这枚图形竖向偏窄，画面只占 viewBox 的高 87% / 宽 64%，两侧内边距比上一枚方形图标大很多 */
.fab-glyph {
    width: 60rpx;
    height: 60rpx;
    /* 轻微呼吸：静态 emoji 换成图形后仍嫌不够抢眼，动一下才像「按住就能说」 */
    animation: fab-breathe 3.6s ease-in-out infinite;
}

@keyframes fab-breathe {

    0%,
    100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.2);
    }
}

.fab-hidden {
    opacity: 0;
    /* 降到遮罩与面板之下：已经锁定的手势不受层级变化影响，
       但另一根手指误点这个隐形区域时不会再触发 touchend，避免录音被提前发送 */
    z-index: 17;
}

/* ==================== 录音面板（由按钮圆形原位扩大到底部约 1/3 屏） ==================== */
/* 只压暗、不接管：列表仍可见，避免原本全屏遮罩的「界面过大」 */
.record-veil {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 18;
    /* 轻度压暗就够：主次交给列表的缩小去表达，不再像原本全屏遮罩那样黑成一片 */
    background: rgba(0, 0, 0, 0.25);
}

.record-sheet {
    position: fixed;
    /* 收起态兜底几何（与 .fab 完全重合的 100rpx 圆）：
       正常流程下由 JS 按视口算成 px 走内联 style，两态同单位才能稳定插值 */
    left: 610rpx;
    /* 内联 style 带 top + height 时这一行会被忽略，只当降级兜底 */
    bottom: 60rpx;
    width: 100rpx;
    height: 100rpx;
    border-radius: 50rpx 50rpx 50rpx 50rpx;
    display: flex;
    align-items: stretch;
    background: var(--primary);
    /* 收起态沿用按钮的投影，与按钮重合的那一帧看不出两个圆 */
    box-shadow: 0 6rpx 20rpx rgba(22, 119, 255, 0.4);
    overflow: hidden;
    z-index: 19;
    /* 几何量同时过渡，视觉上就是圆角先撑开、再长成一个方形面板 */
    transition:
        left 0.32s cubic-bezier(0.22, 0.61, 0.36, 1),
        top 0.32s cubic-bezier(0.22, 0.61, 0.36, 1),
        width 0.32s cubic-bezier(0.22, 0.61, 0.36, 1),
        height 0.32s cubic-bezier(0.22, 0.61, 0.36, 1),
        border-radius 0.32s ease,
        background-color 0.32s ease,
        box-shadow 0.32s ease;
}

/* 展开态只换背景与放内容，几何量走内联 style（见 timeline.js 的 sheetStyles） */
.record-sheet.open {
    background: var(--card);
    box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.12);
}

/* 上滑进入取消区：整片面板转红底，取消态一眼可辨 */
.record-sheet.open.canceling {
    background: var(--danger-weak);
}

/* 顶部取消横带：从面板顶边到触发线都算命中区，✕ 与文字横排居中（旧内核不支持 flex gap，用 margin 拉开） */
.sheet-cancel {
    /* 脱开 .record-sheet 的 flex 行布局：不再挤占主体宽度，只挂在面板顶部 */
    position: absolute;
    top: 12rpx;
    right: 0;
    left: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    opacity: 0;
    /* 回缩时不拖延（基础规则无延迟），展开时才等面板先撑开 */
    transition: opacity 0.15s ease;
}

.record-sheet.open .sheet-cancel {
    opacity: 1;
    transition: opacity 0.2s ease 0.12s;
}

.cancel-label {
    margin: 20rpx 0 0 0;
    font-size: 22rpx;
    color: var(--text-3);
}

.record-sheet.canceling .cancel-label {
    color: var(--danger);
}

/* 中间主体：时长 + 波形 */
.sheet-main {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* 上留 100rpx 让位给顶部 ✕ 横带（离顶 12rpx + 圆 80rpx），下留 72rpx 让位给底句提示；
       取消横带改成绝对定位后不再挤占左侧，主体天然落在屏幕中轴上 */
    padding: 100rpx 0 72rpx;
    opacity: 0;
    transition: opacity 0.15s ease;
}

.record-sheet.open .sheet-main {
    opacity: 1;
    transition: opacity 0.2s ease 0.12s;
}

.sheet-status {
    display: flex;
    align-items: center;
}

/* 录音中的红色呼吸点 */
.rec-dot {
    width: 16rpx;
    height: 16rpx;
    margin-right: 14rpx;
    border-radius: 50%;
    background: var(--danger);
    animation: breathe 1.2s ease-in-out infinite;
}

@keyframes breathe {

    0%,
    100% {
        opacity: 0.35;
        transform: scale(0.8);
    }

    50% {
        opacity: 1;
        transform: scale(1.15);
    }
}

.sheet-time {
    font-size: 56rpx;
    font-weight: 600;
    color: var(--text-1);
}

.sheet-limit {
    margin-left: 16rpx;
    font-size: 24rpx;
    color: var(--warning);
}

/* 波形条（旧内核不支持 flex gap，一律用 margin 拉开） */
.wave {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 140rpx;
    margin: 16rpx 0 12rpx;
}

.wave-bar {
    width: 8rpx;
    margin: 0 4rpx;
    border-radius: var(--radius-pill);
    background: var(--primary);
    animation-name: wave;
    animation-duration: 0.7s;
    animation-timing-function: ease-in-out;
    animation-direction: alternate;
    animation-iteration-count: infinite;
}

@keyframes wave {
    from {
        opacity: 0.5;
        transform: scaleY(0.28);
    }

    to {
        opacity: 1;
        transform: scaleY(1);
    }
}

.record-sheet.canceling .wave-bar {
    background: var(--danger);
}

.sheet-hint {
    /* 脱主体贴底单独占整条面板宽：这句最长（带「最长 60 秒」），塞在主体里会被挤到折行；
       绝对定位基准是 .record-sheet */
    position: absolute;
    right: 0;
    /* 20rpx 而不更高：再往上就会与主体的下沿（离底 72rpx）蹭上 */
    bottom: 20rpx;
    left: 0;
    font-size: 24rpx;
    color: var(--text-3);
    text-align: center;
}