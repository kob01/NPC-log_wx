.login {
  min-height: 100vh;
  padding: 120rpx 60rpx 0;
  background: linear-gradient(180deg, var(--primary-weak) 0%, var(--bg) 40%);
}

.brand {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  border-radius: 32rpx;
  background: var(--primary);
  color: var(--text-inv);
  font-size: 64rpx;
}

.brand-name {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.brand-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.form {
  background: var(--card);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: var(--shadow);
}

.field {
  margin-bottom: 30rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-2);
}

.field-input {
  margin-top: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg);
  border-radius: 14rpx;
  font-size: 30rpx;
}

.login-btn {
  margin-top: 20rpx;
}

/* 静默微信登录期间的占位（高度与表单接近，不让卡片塌一下再弹回来） */
.auto-login {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.auto-login-text {
  font-size: 28rpx;
  color: var(--text-3);
}

.auto-login-skip {
  margin-top: 24rpx;
  padding: 8rpx 20rpx;
  font-size: 26rpx;
  color: var(--primary);
}

/* 微信登录区：后端未开放微信登录时整块隐去 */
.wx-area {
  margin-top: 8rpx;
}

.wx-divider {
  display: flex;
  align-items: center;
  margin: 32rpx 0 24rpx;
  font-size: 22rpx;
  color: var(--text-4);
}

.wx-divider::before,
.wx-divider::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: var(--border);
}

.wx-divider-text {
  padding: 0 16rpx;
}

/* 微信绿不走主题 token：品牌色，深色模式下也不该变成蓝色 */
.btn-wx {
  background: #07c160;
  color: var(--text-inv);
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

/* 原生 button 自带的 1px 描边在 ::after 上，不去掉会和微信绿拼不出一个整块 */
.btn-wx::after {
  border: none;
}

.btn-wx[disabled] {
  opacity: 0.6;
  color: var(--text-inv);
}

.wx-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.tip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-4);
}