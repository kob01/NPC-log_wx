.login {
  min-height: 100vh;
  padding: 120rpx 60rpx 0;
  background: linear-gradient(180deg, var(--primary-weak) 0%, var(--bg) 40%);
}

.brand {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  border-radius: 32rpx;
  background: var(--primary);
  color: var(--text-inv);
  font-size: 64rpx;
}

.brand-name {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.brand-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.form {
  background: var(--card);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: var(--shadow);
}

.field {
  margin-bottom: 30rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-2);
}

.field-input {
  margin-top: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg);
  border-radius: 14rpx;
  font-size: 30rpx;
}

.login-btn {
  margin-top: 20rpx;
}

.tip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-4);
}