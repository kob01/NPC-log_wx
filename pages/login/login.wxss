.login {
  min-height: 100vh;
  padding: 120rpx 60rpx 0;
  background: linear-gradient(180deg, #eaf2ff 0%, #f5f6f8 40%);
}

.brand {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  border-radius: 32rpx;
  background: #1677ff;
  color: #fff;
  font-size: 64rpx;
}

.brand-name {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.brand-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
}

.form {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.field {
  margin-bottom: 30rpx;
}

.field-label {
  font-size: 26rpx;
  color: #666;
}

.field-input {
  margin-top: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f6f8;
  border-radius: 14rpx;
  font-size: 30rpx;
}

.login-btn {
  margin-top: 20rpx;
}

.tip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
