<view class="login page-root {{themeClass}}">
  <view class="brand">
    <view class="logo">◎</view>
    <view class="brand-name">NPC存档</view>
  </view>

  <view class="form">
    <view class="auto-login" wx:if="{{autoLogging}}">
      <text class="auto-login-text">正在用微信登录…</text>
      <view class="auto-login-skip" bindtap="onSkipAuto">改用账号密码登录</view>
    </view>

    <block wx:else>
      <view class="field">
        <text class="field-label">账号</text>
        <input
          class="field-input"
          placeholder="请输入用户名"
          value="{{username}}"
          data-key="username"
          bindinput="onInput"
        />
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <input
          class="field-input"
          password
          placeholder="请输入密码"
          value="{{password}}"
          data-key="password"
          bindinput="onInput"
        />
      </view>

      <button class="btn-primary login-btn" loading="{{loading}}" bindtap="onLogin">
        登 录
      </button>

      <view class="wx-area" wx:if="{{wxAvailable}}">
        <view class="wx-divider"><text class="wx-divider-text">或</text></view>
        <button
          class="btn-wx wx-btn"
          loading="{{wxLoading}}"
          bindtap="onWxLogin"
        >
          微信一键登录
        </button>
        <view class="wx-tip">首次使用请先用账号密码登录一次，会自动绑定当前微信</view>
      </view>
    </block>

    <view class="tip">登录即表示同意相关服务条款</view>
  </view>
</view>
