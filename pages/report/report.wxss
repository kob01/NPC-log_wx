.report {
  min-height: 100vh;
  padding: 20rpx 0 40rpx;
}

.year-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 与下方 .stats/.card 的 24rpx 左右缘对齐 */
  padding: 0 24rpx 10rpx;
}

.year-picker {
  padding: 12rpx 36rpx;
  background: var(--card);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
}

.reload {
  font-size: 26rpx;
  color: var(--primary);
}

.report .card {
  margin: 0 24rpx 20rpx;
}

.hint-bar.error {
  margin: 0 24rpx 20rpx;
  background: var(--danger-weak);
  color: var(--danger);
}

.stats {
  display: flex;
  background: var(--card);
  border-radius: var(--radius);
  margin: 0 24rpx 20rpx;
  padding: 30rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-sub {
  font-size: 24rpx;
  color: var(--text-4);
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-body);
  white-space: pre-wrap;
}

.tag-cloud {
  margin-top: 12rpx;
}

.meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-4);
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.bar-name {
  width: 140rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.bar-track {
  flex: 1;
  height: 16rpx;
  background: var(--fill);
  border-radius: var(--radius-pill);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-2), var(--primary));
  border-radius: var(--radius-pill);
}

.bar-count {
  width: 60rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-3);
}

.month-item {
  display: flex;
  padding: 14rpx 0;
}

.month-dot {
  width: 16rpx;
  height: 16rpx;
  margin: 12rpx 20rpx 0 4rpx;
  border-radius: 50%;
  background: var(--text-4);
  flex-shrink: 0;
}

.month-dot.on {
  background: var(--primary);
}

.month-body {
  flex: 1;
  /* 防止长摘要撑不开省略号（flex 项默认 min-width:auto） */
  min-width: 0;
}

.month-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-name {
  font-size: 28rpx;
  font-weight: 600;
}

.month-count {
  font-size: 22rpx;
  color: var(--text-3);
}

.month-summary {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-3);
}