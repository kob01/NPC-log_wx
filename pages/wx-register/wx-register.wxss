.wx-register {
    min-height: 100vh;
    padding: 24rpx 0 60rpx;
}

.intro {
    display: flex;
    flex-direction: column;
    padding: 24rpx 40rpx 8rpx;
}

.intro-title {
    font-size: 34rpx;
    font-weight: 600;
    color: var(--text-1);
}

.intro-desc {
    margin-top: 12rpx;
    font-size: 24rpx;
    line-height: 1.6;
    color: var(--text-3);
}

/* 「不能修改」这句必须比说明更重，否则用户会随手敲一个再来找管理员改 */
.intro-warn {
    margin-top: 12rpx;
    font-size: 24rpx;
    font-weight: 600;
    color: var(--warning);
}

.field {
    margin-bottom: 30rpx;
}

.field-label {
    font-size: 26rpx;
    color: var(--text-2);
}

.field-input {
    margin-top: 12rpx;
    height: 88rpx;
    padding: 0 24rpx;
    background: var(--bg);
    border-radius: 14rpx;
    font-size: 30rpx;
}

.submit-btn {
    margin-top: 10rpx;
}

.tip {
    margin-top: 24rpx;
    text-align: center;
    font-size: 22rpx;
    color: var(--text-4);
    line-height: 1.5;
}