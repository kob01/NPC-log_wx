.edit {
    min-height: 100vh;
    padding: 20rpx 24rpx 40rpx;
}

.form-item {
    background: var(--card);
    border-radius: var(--radius);
    padding: 24rpx;
    margin-bottom: 20rpx;
}

.label {
    font-size: 28rpx;
    font-weight: 600;
    margin-bottom: 16rpx;
}

/* 标题行：左侧标题 + 右侧行内入口（图片区的「从聊天选图」） */
.label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.req {
    color: var(--danger);
    margin-left: 6rpx;
}

/* 「进度/记录」已含感受，括号补充说明用轻字重，不抢标题 */
.sub-label {
    font-size: 24rpx;
    font-weight: 400;
    color: var(--text-3, #8c8c8c);
}

/* 多行文本框：auto-height 随内容撑高，初始 2 行，最多撑到 5 行（行高 40rpx + 上下 padding 36rpx） */
.area {
    width: 100%;
    min-height: 116rpx;
    max-height: 236rpx;
    padding: 18rpx;
    background: var(--bg);
    border-radius: var(--radius);
    font-size: 28rpx;
    line-height: 40rpx;
    box-sizing: border-box;
}

.input {
    width: 100%;
    height: 76rpx;
    padding: 0 18rpx;
    background: var(--bg);
    border-radius: var(--radius);
    font-size: 28rpx;
    box-sizing: border-box;
}

.time-row {
    display: flex;
}

.picker-box {
    min-width: 220rpx;
    height: 76rpx;
    line-height: 76rpx;
    padding: 0 24rpx;
    margin-right: 20rpx;
    background: var(--bg);
    border-radius: var(--radius);
    font-size: 28rpx;
    text-align: center;
}

.picker-box.small {
    min-width: 150rpx;
    height: 64rpx;
    line-height: 64rpx;
    font-size: 24rpx;
    margin: 0;
}

.picker-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76rpx;
    padding: 0 18rpx;
    background: var(--bg);
    border-radius: var(--radius);
    font-size: 28rpx;
}

.arrow {
    color: var(--text-4);
    font-size: 34rpx;
}

.loc-box {
    position: relative;
    /* 右侧给绝对定位的「✕ 清除」留位，否则长地点/地址会被按钮压住 */
    padding: 20rpx 150rpx 20rpx 18rpx;
    background: var(--bg);
    border-radius: var(--radius);
    min-height: 76rpx;
}

.loc-empty {
    font-size: 28rpx;
    color: var(--text-3);
}

.loc-name {
    font-size: 28rpx;
    color: var(--text-1);
}

.loc-addr {
    margin-top: 6rpx;
    font-size: 24rpx;
    color: var(--text-3);
}

.loc-clear {
    position: absolute;
    right: 18rpx;
    top: 20rpx;
    font-size: 24rpx;
    color: var(--danger);
}

.img-grid {
    display: flex;
    flex-wrap: wrap;
}

.img-cell {
    position: relative;
    width: 160rpx;
    height: 160rpx;
    margin: 0 16rpx 16rpx 0;
}

.img {
    width: 160rpx;
    height: 160rpx;
    border-radius: var(--radius);
}

.img-del {
    position: absolute;
    right: -10rpx;
    top: -10rpx;
    width: 40rpx;
    height: 40rpx;
    line-height: 40rpx;
    text-align: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    color: var(--text-inv);
    font-size: 24rpx;
}

.img-add {
    width: 160rpx;
    height: 160rpx;
    line-height: 156rpx;
    text-align: center;
    border: 2rpx dashed var(--text-4);
    border-radius: var(--radius);
    color: var(--text-4);
    font-size: 60rpx;
}

.uploading {
    font-size: 24rpx;
    color: var(--primary);
}

/* ==================== 从微信聊天选图 ==================== */
/* wx.chooseMessageFile 的入口：九宫格里的「＋」是相册/拍摄，这里挂在图片标题行最右侧 */
.chat-pick {
    display: flex;
    align-items: center;
    /* 标题行是 flex，用 margin 撑间距而不是 gap（旧内核不支持） */
    margin-left: 16rpx;
    font-weight: 400;
}

.chat-pick-main {
    font-size: 26rpx;
    color: var(--primary);
    white-space: nowrap;
}

.chat-pick .arrow {
    margin-left: 6rpx;
}

.org-tip {
    font-size: 22rpx;
    color: var(--text-3);
    margin-bottom: 8rpx;
}

.org-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 0;
    border-bottom: 1rpx solid var(--divider);
}

/* 最后一行不拖分隔线 */
.org-row-last {
    border-bottom: none;
}

.org-check {
    width: 40rpx;
    height: 40rpx;
    line-height: 40rpx;
    text-align: center;
    border: 2rpx solid var(--text-4);
    border-radius: var(--radius);
    color: var(--text-inv);
}

.org-check.on {
    background: var(--primary);
    border-color: var(--primary);
}

.link-row {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
}

.link-platform {
    margin-right: 12rpx;
}

.link-url {
    flex: 1;
    height: 64rpx;
    padding: 0 18rpx;
    background: var(--bg);
    border-radius: var(--radius);
    font-size: 26rpx;
}

.link-del {
    margin-left: 16rpx;
    color: var(--danger);
    font-size: 30rpx;
}

.link-add {
    font-size: 26rpx;
    color: var(--primary);
    padding: 8rpx 0;
}

.footer-space {
    /* 高度需盖住底部提交栏（含安全区），否则最后一项表单会被提交栏遮住 */
    height: calc(180rpx + env(safe-area-inset-bottom));
}

.submit-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    /* 高于原生 input/textarea 层，否则滚动到提交栏下方的输入框会盖住按钮，点“保存修改”会穿透聚焦到下层输入框 */
    z-index: 50;
    padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
    background: var(--card);
    box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* ==================== 录音悬浮卡片 ==================== */
.voice-panel {
    position: fixed;
    left: 24rpx;
    right: 24rpx;
    /* 原来固定 150rpx 会压在提交栏上（提交栏高约 156rpx + 安全区） */
    bottom: calc(180rpx + env(safe-area-inset-bottom));
    z-index: 30;
    background: #1f1f1f;
    border-radius: var(--radius);
    padding: 20rpx 24rpx;
    box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.25);
}

.voice-panel.collapsed {
    padding: 12rpx 24rpx;
}

.voice-head {
    display: flex;
    align-items: center;
}

.voice-play {
    width: 56rpx;
    height: 56rpx;
    line-height: 56rpx;
    text-align: center;
    border-radius: 50%;
    background: var(--primary);
    color: var(--text-inv);
    font-size: 26rpx;
    margin-right: 16rpx;
}

.voice-dur {
    color: #bbb;
    font-size: 26rpx;
    margin-right: 16rpx;
}

.voice-status {
    flex: 1;
    color: #4d9fff;
    font-size: 24rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* 识别失败后的原地重试：用 margin 不用 flex gap（旧内核不支持 gap） */
.voice-retry {
    margin: 0 12rpx;
    padding: 2rpx 18rpx;
    border: 1rpx solid #4d9fff;
    border-radius: var(--radius-pill);
    color: #4d9fff;
    font-size: 22rpx;
    line-height: 1.7;
}

/* 失败成因整行展示、不省略：让用户看出是“服务额度不足”而不是自己没录好 */
.voice-reason {
    margin-top: 12rpx;
    color: #f5a623;
    font-size: 24rpx;
    line-height: 1.5;
    word-break: break-all;
}

.voice-fold {
    color: #888;
    font-size: 30rpx;
    padding: 0 20rpx;
}

.voice-close {
    color: #888;
    font-size: 28rpx;
    padding: 0 4rpx;
}

.voice-text {
    margin-top: 16rpx;
    color: #ddd;
    font-size: 26rpx;
    line-height: 1.6;
    max-height: 160rpx;
    overflow: hidden;
}