<view class="edit page-root {{themeClass}}">
  <!-- 时间 -->
  <view class="form-item">
    <view class="label">时间<text class="req">*</text></view>
    <view class="time-row">
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="picker-box">{{date || '选择日期'}}</view>
      </picker>
      <picker mode="time" value="{{timeStr}}" bindchange="onTimeChange">
        <view class="picker-box">{{timeStr || '选择时间'}}</view>
      </picker>
    </view>
  </view>

  <!-- 事件 -->
  <view class="form-item">
    <view class="label">事件<text class="req">*</text></view>
    <textarea class="area" auto-height placeholder="发生了什么？" maxlength="200" value="{{event}}" data-key="event" bindinput="onInput" />
  </view>

  <!-- 分类 -->
  <view class="form-item">
    <view class="label">分类</view>
    <picker mode="selector" range="{{typeOptions}}" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="picker-line">{{typeIndex >= 0 ? typeOptions[typeIndex] : '请选择分类'}} <text class="arrow">›</text></view>
    </picker>
  </view>

  <!-- 进度/记录（含感受，两者已合并为一个正文框） -->
  <view class="form-item">
    <view class="label">进度 / 记录<text class="sub-label">（含感受）</text></view>
    <textarea class="area" auto-height placeholder="详细经过与当时的感受…" maxlength="4000" value="{{content}}" data-key="content" bindinput="onInput" />
  </view>

  <!-- 录音卡（内联于进度/记录下方，刚录的与日志已存的都走这里）：▶ 播放，有转写文本/失败成因时可折叠展开 -->
  <view class="voice-panel" wx:if="{{voice}}">
    <view class="voice-head">
      <view class="voice-play" catchtap="togglePlay">
        <image class="voice-glyph" wx:if="{{playing}}" mode="aspectFit" src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0Ij48cmVjdCB4PSI2IiB5PSI1IiB3aWR0aD0iNCIgaGVpZ2h0PSIxNCIgcng9IjEuMiIgZmlsbD0iI2ZmZmZmZiIvPjxyZWN0IHg9IjE0IiB5PSI1IiB3aWR0aD0iNCIgaGVpZ2h0PSIxNCIgcng9IjEuMiIgZmlsbD0iI2ZmZmZmZiIvPjwvc3ZnPg==" />
        <image class="voice-glyph" wx:else mode="aspectFit" src="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgd2lkdGg9IjI0IiBoZWlnaHQ9IjI0Ij48cGF0aCBkPSJNOCA1djE0bDExLTd6IiBmaWxsPSIjZmZmZmZmIi8+PC9zdmc+" />
      </view>
      <text class="voice-dur">{{recording ? recSeconds : voice.duration}}″</text>
      <text class="voice-status">{{voiceStatus}}</text>
      <text class="voice-retry" wx:if="{{voiceRetryable}}" catchtap="retryTranscribe">重试</text>
      <!-- 无转写正文也无失败成因时，折叠/展开没有可展示的内容，直接隐藏这个开关 -->
      <text class="voice-fold {{voiceCollapsed ? 'fold-down' : 'fold-up'}}" wx:if="{{voice.text || voiceReason}}" catchtap="toggleVoiceCollapsed">›</text>
    </view>
    <view class="voice-text" wx:if="{{!voiceCollapsed && voice.text}}">{{voice.text}}</view>
    <!-- 失败成因单独一行完整展示：头部 .voice-status 是单行省略，装不下“额度不足需充值”这种长句 -->
    <view class="voice-reason" wx:if="{{!voiceCollapsed && voiceReason}}">{{voiceReason}}</view>
    <!-- 操作行：与图片的加/删对称 —— 重录（点按开/停，结束即替换）、移除（保存时告知后端清空旧文件） -->
    <view class="voice-actions">
      <text class="voice-act {{recording ? 'voice-act-on' : ''}}" catchtap="toggleReRecord">{{recording ? '停止录音' : '重录'}}</text>
      <text class="voice-act voice-act-del" catchtap="removeVoice">移除录音</text>
    </view>
  </view>

  <!-- 评价 -->
  <view class="form-item">
    <view class="label">评价</view>
    <picker mode="selector" range="{{ratingOptions}}" value="{{ratingIndex}}" bindchange="onRatingChange">
      <view class="picker-line">{{ratingIndex >= 0 ? ratingOptions[ratingIndex] : '请选择评价'}} <text class="arrow">›</text></view>
    </picker>
  </view>

  <!-- 经验教训 -->
  <view class="form-item">
    <view class="label">经验教训</view>
    <textarea class="area" auto-height placeholder="学到了什么？" maxlength="1000" value="{{experience}}" data-key="experience" bindinput="onInput" />
  </view>

  <!-- 地点 -->
  <view class="form-item">
    <view class="label">地点</view>
    <view class="loc-box" bindtap="chooseLocation">
      <block wx:if="{{location.position}}">
        <view class="loc-name">📍 {{location.position}}</view>
        <view class="loc-addr" wx:if="{{location.address}}">{{location.address}}</view>
        <text class="loc-clear" catchtap="clearLocation">✕ 清除</text>
      </block>
      <view class="loc-empty" wx:else>点击选择地点（地图选点）<text class="arrow">›</text></view>
    </view>
  </view>

  <!-- 见证者 -->
  <view class="form-item">
    <view class="label">见证者</view>
    <input class="input" placeholder="有谁在场？" maxlength="100" value="{{witness}}" data-key="witness" bindinput="onInput" />
  </view>

  <!-- 图片 -->
  <view class="form-item">
    <view class="label label-row">
      <text>图片（{{images.length}}/9）</text>
      <!-- 微信生态独有入口：会话里的图（单聊/群/文件传输助手）能直接选，不需资质也不需后端改动 -->
      <view class="chat-pick" wx:if="{{canPickChat && images.length < 9}}" bindtap="pickFromChat">
        <text class="chat-pick-main">💬从微信聊天里选图</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <!-- 拖拽排序：长按某张图→浮层跟手→越过其它格子实时换位。touchmove/touchend 绑在网格容器上，
         换位时被拖节点仍在容器内、事件照常冒泡，而容器本身不参与 wx:for 不会被重排 -->
    <view
      class="img-grid"
      bindtouchmove="onGridTouchMove"
      bindtouchend="onGridTouchEnd"
      bindtouchcancel="onGridTouchEnd"
    >
      <view
        class="img-cell {{dragging && dragIndex === index ? 'img-cell-dragging' : ''}}"
        wx:for="{{images}}"
        wx:key="url"
        data-index="{{index}}"
        bindtouchstart="onImgTouchStart"
        bindlongpress="onImgLongPress"
      >
        <image class="img" src="{{item.displayUrl}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
        <view class="img-del" data-index="{{index}}" catchtap="removeImage">✕</view>
      </view>
      <view class="img-add" wx:if="{{images.length < 9}}" bindtap="chooseImage">＋</view>
    </view>
    <view class="img-tip" wx:if="{{images.length > 1 && !uploading}}">长按图片可拖动改变顺序</view>
    <view class="uploading" wx:if="{{uploading}}">图片上传中…</view>
  </view>

  <!-- 可见范围 -->
  <view class="form-item">
    <view class="label">可见范围</view>
    <picker mode="selector" range="{{visibilityOptions}}" value="{{visibilityIndex}}" bindchange="onVisibilityChange">
      <view class="picker-line">{{visibilityOptions[visibilityIndex]}} <text class="arrow">›</text></view>
    </picker>
  </view>

  <!-- 可见组织（组织可见时） -->
  <view class="form-item" wx:if="{{visibilityIndex === 1}}">
    <view class="label">可见组织</view>
    <view class="hint-bar" wx:if="{{!orgOptions.length}}">你还没有加入任何组织</view>
    <view wx:else>
      <view class="org-tip">不选则默认所有已加入组织可见</view>
      <view
        class="org-row {{last ? 'org-row-last' : ''}}"
        wx:for="{{orgOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="toggleOrg"
      >
        <text class="org-name">{{item.org_name}}</text>
        <text class="org-check {{item.checked ? 'on' : ''}}">{{item.checked ? '✓' : ''}}</text>
      </view>
    </view>
  </view>

  <!-- 作品链接 -->
  <view class="form-item">
    <view class="label">作品链接</view>
    <view class="link-row" wx:for="{{links}}" wx:key="index">
      <picker class="link-platform" mode="selector" range="{{platformLabels}}" value="{{item.platformIndex}}" data-index="{{index}}" bindchange="onLinkPlatform">
        <view class="picker-box small">{{platformLabels[item.platformIndex]}}</view>
      </picker>
      <input class="link-url" placeholder="链接地址" value="{{item.url}}" data-index="{{index}}" bindinput="onLinkUrl" />
      <text class="link-del" data-index="{{index}}" catchtap="removeLink">✕</text>
    </view>
    <view class="link-add" bindtap="addLink">＋ 添加链接</view>
  </view>

  <view class="footer-space"></view>

  <view class="submit-bar">
    <button class="btn-primary submit-btn" loading="{{submitting}}" bindtap="onSubmit">
      {{id ? '保存修改' : '发布日志'}}
    </button>
  </view>

  <!-- 图片拖拽浮层：跟手的放大缩略图（position: fixed 相对视口，故放在根节点下避开任何可能的 transform 祖先） -->
  <view class="img-drag-ghost" wx:if="{{dragging}}" style="left: {{dragPos.x}}px; top: {{dragPos.y}}px;">
    <image class="img-drag-ghost-img" src="{{dragUrl}}" mode="aspectFill" />
  </view>
</view>
