<view class="reminders page-root {{themeClass}}">
  <!-- 额度卡：微信那一路的一切成败取决于「有没有绑定」+「还有没有次数」；邮件通道不受这两条限制 -->
  <view class="card">
    <view class="row-between">
      <view class="flex-1">
        <view class="sum-title">剩余提醒次数 {{cfg.quota || 0}}</view>
        <view class="text-2 text-sm">
          微信限制：授权一次只能推送一条；邮件提醒不消耗这些次数
        </view>
      </view>
      <button
        class="btn-ghost sub-btn"
        loading="{{busyAuth}}"
        bindtap="onAuthorize"
      >续订次数</button>
    </view>
    <view class="quota-row" wx:if="{{cfg}}">
      <view class="tag {{cfg.wxBound ? 'tag-green' : 'tag-red'}}">
        {{cfg.wxBound ? '已绑定微信' : '未绑定微信'}}
      </view>
      <view class="tag {{cfg.enabled ? 'tag-blue' : 'tag-orange'}}">
        {{cfg.enabled ? '服务端可推送' : '服务端未配模板'}}
      </view>
      <view class="tag {{cfg.mailEnabled ? 'tag-blue' : 'tag-orange'}}">
        {{cfg.mailEnabled ? '邮件通道可用' : '服务端未配邮件'}}
      </view>
      <view class="tag tag-gray" wx:if="{{cfg.pending}}">{{cfg.pending}} 条待发</view>
    </view>
    <view class="hint-bar hint-gap" wx:if="{{hint}}">{{hint}}</view>
    <view class="link-row">
      <text class="link" bindtap="onTest">发一条测试</text>
      <text class="link-sep" wx:if="{{cfg && cfg.mailEnabled}}">·</text>
      <text class="link" wx:if="{{cfg && cfg.mailEnabled}}" bindtap="onTestMail">发一封测试邮件</text>
      <text class="link-sep">·</text>
      <text class="link" bindtap="toggleDone">{{withDone ? '只看进行中' : '含已结束'}}</text>
      <text class="link-sep" wx:if="{{cfg && !cfg.wxBound}}">·</text>
      <text class="link" wx:if="{{cfg && !cfg.wxBound}}" bindtap="goProfile">去绑定微信</text>
    </view>
  </view>

  <!-- 新建 / 编辑表单 -->
  <view class="card" wx:if="{{showForm}}">
    <view class="section-title">{{form.id ? '编辑提醒' : '新建提醒'}}</view>
    <view class="sub-tip">{{needWxSub ? subHint : emailHint}}</view>

    <view class="fld">
      <view class="fld-label">提醒内容</view>
      <input
        class="fld-input"
        placeholder="要提醒我什么？"
        maxlength="200"
        value="{{form.title}}"
        data-key="title"
        bindinput="onInput"
      />
    </view>

    <view class="fld">
      <view class="fld-label">提醒时间</view>
      <view class="row">
        <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
          <view class="picker-box">{{form.date || '选择日期'}}</view>
        </picker>
        <picker mode="time" value="{{form.timeStr}}" bindchange="onTimeChange">
          <view class="picker-box picker-gap">{{form.timeStr || '选择时间'}}</view>
        </picker>
        <view class="quick-chip" bindtap="onPickNow">现在</view>
      </view>
    </view>

    <view class="fld">
      <view class="fld-label">重复</view>
      <picker mode="selector" range="{{repeats}}" range-key="label" value="{{form.repeatIndex}}" bindchange="onRepeatChange">
        <view class="picker-line">
          {{repeats[form.repeatIndex].label}} <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 自定义间隔：只在选到「自定义间隔」时才出现（推完一次隔这么久再推下一次） -->
    <view class="fld" wx:if="{{repeats[form.repeatIndex].value === 'custom'}}">
      <view class="fld-label">间隔</view>
      <view class="row">
        <input
          class="fld-input interval-input"
          type="number"
          maxlength="3"
          placeholder="数值"
          value="{{form.intervalValue}}"
          bindinput="onIntervalInput"
        />
        <picker class="interval-unit" mode="selector" range="{{intervalUnits}}" range-key="label" value="{{form.intervalUnitIndex}}" bindchange="onIntervalUnitChange">
          <view class="picker-box">
            {{intervalUnits[form.intervalUnitIndex].label}} <text class="arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="quick-row">
        <text class="quick-tip">到点推送后隔这么久再推下一次，可填 1~{{intervalMax}}</text>
      </view>
    </view>

    <view class="fld">
      <view class="fld-label">推送渠道</view>
      <picker mode="selector" range="{{channels}}" range-key="label" value="{{form.channelIndex}}" bindchange="onChannelChange">
        <view class="picker-line">
          {{channels[form.channelIndex].label}} <text class="arrow">›</text>
        </view>
      </picker>
      <view class="quick-row" wx:if="{{channels[form.channelIndex].value !== 'wx' && !cfg.mailEnabled}}">
        <text class="quick-tip">服务端还没配邮件通道，这条提醒会先存着不发</text>
      </view>
    </view>

    <view class="fld" wx:if="{{channels[form.channelIndex].value !== 'wx'}}">
      <view class="fld-label">接收邮箱</view>
      <input
        class="fld-input"
        placeholder="留空即发到账号邮箱"
        maxlength="100"
        value="{{form.email}}"
        data-key="email"
        bindinput="onInput"
      />
    </view>

    <view class="fld">
      <view class="fld-label">备注（可选，会一起推到通知与邮件里）</view>
      <textarea
        class="fld-area"
        placeholder="补充一句说明"
        maxlength="500"
        value="{{form.remark}}"
        data-key="remark"
        bindinput="onInput"
      />
    </view>

    <view class="fld" wx:if="{{form.eventName}}">
      <view class="fld-label">关联日志</view>
      <view class="picker-line">{{form.eventName}}</view>
    </view>

    <view class="row form-actions">
      <button class="btn-primary flex-1 act-btn" loading="{{saving}}" bindtap="onSave">
        {{channels[form.channelIndex].value === 'email' ? '保存' : '保存并续订一次'}}
      </button>
      <button class="btn-ghost flex-1 act-btn act-gap" bindtap="onCancelForm">取消</button>
    </view>
  </view>

  <!-- wx:if / wx:else 必须是紧邻的兄弟节点，所以中间不能放注释（注释会打断条件链） -->
  <loading wx:if="{{loading}}" text="加载提醒" />

  <block wx:else>
    <!-- 列表 -->
    <view class="card add-card" wx:if="{{!showForm}}">
      <button class="btn-primary" bindtap="toggleForm">＋ 新建提醒</button>
    </view>

    <view class="rm-card" wx:for="{{list}}" wx:key="id">
      <view class="row-between">
        <view class="flex-1">
          <view class="rm-title ellipsis">{{item.title}}</view>
          <view class="rm-meta">
            <text class="rm-time">{{item.timeText}}</text>
            <text class="dot">·</text>
            <text>{{item.repeatText}}</text>
            <text class="dot">·</text>
            <text>{{item.channelText}}</text>
          </view>
        </view>
        <view class="rm-right">
          <view class="tag {{item.statusCls}} rm-tag">{{item.statusText}}</view>
          <switch
            class="rm-switch"
            checked="{{item.enabled}}"
            color="#1677ff"
            data-id="{{item.id}}"
            bindchange="onToggleStatus"
          />
        </view>
      </view>

      <view class="rm-remark" wx:if="{{item.remark}}">{{item.remark}}</view>
      <view class="rm-remark" wx:elif="{{item.channel !== 'wx'}}">{{item.email || cfg.accountEmail || '未填接收邮箱'}}</view>
      <view class="rm-err" wx:if="{{item.lastError && item.status !== 1}}">
        上次：{{item.lastError}}
      </view>
      <view class="rm-err" wx:elif="{{item.status === 0 && item.lastPushText}}">
        上次推送：{{item.lastPushText}}
      </view>

      <view class="rm-actions">
        <text class="link" wx:if="{{item.eventId}}" data-id="{{item.eventId}}" bindtap="goEvent">查看日志</text>
        <text class="link" data-id="{{item.id}}" bindtap="onEdit">编辑</text>
        <text class="link link-danger" data-id="{{item.id}}" bindtap="onDelete">删除</text>
      </view>
    </view>

    <empty-state
      wx:if="{{!list.length && !showForm}}"
      icon="🔔"
      text="还没有提醒，点上面「新建提醒」试试"
    />
  </block>
</view>
