<page-meta
  page-orientation="{{orientation}}"
  page-style="{{fs ? 'overflow:hidden;' : ''}}"
  bind:resize="onPageResize"
/>

<!-- page-meta 必须是页面第一个节点（注释也可能被打断判定，故说明写在下方），它自身不渲染内容，页面内容仍是它的兄弟节点 -->

<view class="footprint page-root {{themeClass}}">
  <!-- 过滤条：全屏时隐藏，把整屏留给地图 -->
  <view class="filter" wx:if="{{!fs}}">
    <scroll-view class="chips" scroll-x>
      <!-- 「全部」带的是全年份之和（allTotal），不是当年那一档的数量 -->
      <view class="chip {{year === '' ? 'active' : ''}}" data-year="" bindtap="onYearChip">全部({{allTotal}})</view>
      <view
        class="chip {{year === item.year ? 'active' : ''}}"
        wx:for="{{years}}"
        wx:key="year"
        data-year="{{item.year}}"
        bindtap="onYearChip"
      >
        {{item.year}}({{item.count}})
      </view>
    </scroll-view>
    <view class="tag-search">
      <input
        class="tag-input"
        placeholder="按标签筛选"
        value="{{tag}}"
        confirm-type="search"
        bindinput="onTagInput"
        bindconfirm="onTagSearch"
      />
      <text class="tag-go" bindtap="onTagSearch">筛选</text>
    </view>
  </view>

  <!-- 地图 -->
  <view class="map-wrap {{fs ? 'map-wrap--fs' : ''}}" wx:if="{{markers.length}}">
    <map
      id="footprintMap"
      class="map"
      latitude="{{center.latitude}}"
      longitude="{{center.longitude}}"
      scale="{{scale}}"
      markers="{{markers}}"
      include-points="{{includePoints}}"
      bindmarkertap="onMarkerTap"
      show-location
    />
    <!-- 全屏入口右上、退出左上：同一位置反复点不会误触，且避开微信右上胶囊 -->
    <view class="fs-btn" wx:if="{{!fs}}" bindtap="enterFs">全屏</view>
    <view class="fs-exit" wx:if="{{fs}}" bindtap="exitFs">退出全屏</view>
    <!-- 选中点位后的操作按钮：绝对定位浮在地图右下角上层 -->
    <view class="map-actions" wx:if="{{selected}}">
      <!-- 点位多时 marker 不再带 callout（省掉逐点样式字段），标题改在这里显示 -->
      <view class="map-title ellipsis" wx:if="{{slimCallout}}">{{selected.event}}</view>
      <view class="map-btn" data-id="{{selected.id}}" bindtap="goDetail">详情</view>
      <view class="map-btn primary" bindtap="openNav">导航</view>
    </view>
  </view>

  <loading wx:if="{{loading}}" />
  <view class="hint-bar empty-hint" wx:if="{{!loading && !markers.length}}">
    {{year && allTotal > 0 ? year + ' 年暂无足迹，可切「全部」看看' : '暂无带坐标的足迹'}}
  </view>

  <!-- 地点列表 -->
  <view class="list" wx:if="{{points.length && !fs}}">
    <view class="list-title">足迹列表</view>
    <view class="list-item" wx:for="{{points}}" wx:key="id" data-index="{{index}}" bindtap="onListTap">
      <view class="li-body">
        <view class="li-name ellipsis">{{item.event}}</view>
        <view class="li-meta ellipsis">{{item.time}} · {{item.address || item.position}}</view>
      </view>
      <image class="li-thumb" wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFill" lazy-load />
    </view>
    <!-- 分页脚标：30 条一批自动续拉；触顶时提示上限，到底后与时间线同款「没有更多」 -->
    <view class="list-foot" wx:if="{{loadingMore}}">加载中…</view>
    <view class="list-foot limit-tip" wx:elif="{{limitReached}}">已显示前 {{maxPoints}} 条，更多足迹请切换年份或标签</view>
    <view class="list-foot" wx:elif="{{!hasMore}}">— 没有更多了 —</view>
  </view>
</view>
