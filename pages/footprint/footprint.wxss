.footprint {
    min-height: 100vh;
    /* padding-bottom: 10rpx; */
}

.filter {
    background: var(--card);
    padding: 16rpx 0;
}

.chips {
    white-space: nowrap;
    padding: 0 24rpx 12rpx;
    box-sizing: border-box;
}

.chip {
    display: inline-block;
    padding: 8rpx 26rpx;
    margin-right: 16rpx;
    border-radius: var(--radius-pill);
    font-size: 26rpx;
    background: var(--bg);
    color: var(--text-2);
}

.chip.active {
    background: var(--primary);
    color: var(--text-inv);
}

.tag-search {
    display: flex;
    align-items: center;
    margin: 0 24rpx;
    height: 64rpx;
    padding: 0 8rpx 0 24rpx;
    background: var(--bg);
    border-radius: var(--radius-pill);
}

.tag-input {
    flex: 1;
    font-size: 26rpx;
}

.tag-go {
    padding: 8rpx 26rpx;
    background: var(--primary);
    color: var(--text-inv);
    border-radius: var(--radius-pill);
    font-size: 24rpx;
}

.map-wrap {
    /* 粘性定位：列表上滑时地图贴在导航栏下沿常驻，点击列表项能即时看到地图重定位 */
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    z-index: 10;
    margin-top: 16rpx;
    /* 列表项从地图下方穿过时，靠这条阴影区分层级边界 */
    box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

.map {
    width: 100%;
    height: 560rpx;
    display: block;
}

/* 选中点位后的操作按钮：绝对定位浮在地图右下角上层，缩为一行靠右 */
.map-actions {
    position: absolute;
    right: 20rpx;
    bottom: 20rpx;
    z-index: 20;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.map-btn {
    padding: 6rpx 16rpx;
    border-radius: var(--radius-pill);
    font-size: 22rpx;
    line-height: 1.4;
    text-align: center;
    border: 1rpx solid var(--primary);
    color: var(--primary);
    background: var(--card);
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* 旧内核不支持 flex gap，改用相邻兄弟 margin-left 拉开间距 */
.map-btn+.map-btn {
    margin-left: 12rpx;
}

.map-btn.primary {
    background: var(--primary);
    color: var(--text-inv);
}

.empty-hint {
    margin: 30rpx 24rpx;
}

.list {
    background: var(--card);
    margin: 16rpx 0;
    padding: 10rpx 24rpx;
}

.list-title {
    font-size: 28rpx;
    font-weight: 600;
    padding: 16rpx 0;
}

.list-item {
    display: flex;
    align-items: center;
    padding: 16rpx 0;
    border-top: 1rpx solid var(--divider);
}

.li-thumb {
    width: 80rpx;
    height: 80rpx;
    border-radius: var(--radius);
    margin-left: 16rpx;
    flex-shrink: 0;
}

.li-body {
    flex: 1;
    min-width: 0;
}

.li-name {
    font-size: 28rpx;
}

.li-meta {
    font-size: 22rpx;
    color: var(--text-3);
    margin-top: 4rpx;
}