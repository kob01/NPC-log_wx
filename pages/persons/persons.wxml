<view class="persons page-root {{themeClass}}">
  <!-- 搜索人物 -->
  <view class="search-box">
    <image
      class="search-glyph"
      mode="aspectFit"
      src="data:image/svg+xml;base64,"
    />
    <input
      class="search-input"
      placeholder="搜索人物"
      value="{{keyword}}"
      bindinput="onKeywordInput"
    />
  </view>

  <!-- 人物横滑列表 -->
  <loading wx:if="{{listLoading}}" />
  <scroll-view class="person-scroll" scroll-x wx:elif="{{filtered.length}}">
    <view
      class="person-card {{selected === item.person ? 'active' : ''}}"
      wx:for="{{filtered}}"
      wx:key="person"
      data-name="{{item.person}}"
      bindtap="selectPerson"
      bindlongpress="onBlockPerson"
    >
      <view class="p-avatar" style="background: {{item.avatarColor}}; color: {{item.avatarFg}};">{{item.initial}}</view>
      <view class="p-name ellipsis">{{item.person}}</view>
      <view class="p-count">{{item.count}} 条</view>
    </view>
  </scroll-view>
  <empty-state wx:else text="暂无人物数据（需 AI 抽取人物）" />

  <!-- 屏蔽入口只露这一行：横滑卡片本来就只有头像+姓名+条数，再塞一个 ✕ 就会挤掉名字 -->
  <view class="list-tip" wx:if="{{!listLoading && filtered.length}}">长按卡片可把某人从图谱里隐藏</view>
  <view class="block-row" wx:if="{{blockedCount}}">
    <text class="block-toggle" bindtap="toggleBlocks">已屏蔽 {{blockedCount}} 人 {{showBlocks ? '▴' : '▾'}}</text>
    <view class="block-list" wx:if="{{showBlocks}}">
      <view class="block-item" wx:for="{{blocks}}" wx:key="person">
        <text class="block-name ellipsis">{{item.person}}</text>
        <text class="block-act" data-name="{{item.person}}" bindtap="onUnblock">恢复</text>
      </view>
      <!-- 条数与名单不一致时（刚恢复完还没重拉）宁可说一句空，不能给一个看起来像报错的空白块 -->
      <view class="block-tip" wx:if="{{!blocks.length}}">名单已空，上面的数字下一次进页就会跟着清掉</view>
    </view>
  </view>

  <!-- 所选人物时间线 -->
  <view class="tl" wx:if="{{selected}}">
    <view class="tl-head">
      <text class="tl-name">{{selected}}</text>
      <text class="tl-total" wx:if="{{timeline}}">共 {{timeline.total}} 条</text>
    </view>

    <scroll-view class="chips" scroll-x wx:if="{{yearChips.length}}">
      <view
        class="chip {{year === item.value ? 'active' : ''}}"
        wx:for="{{yearChips}}"
        wx:key="value"
        data-year="{{item.value}}"
        bindtap="onYearChip"
      >
        {{item.label}}
      </view>
    </scroll-view>

    <loading wx:if="{{timelineLoading}}" />
    <block wx:elif="{{timeline && timeline.list.length}}">
      <event-card
        wx:for="{{timeline.list}}"
        wx:key="id"
        entry="{{item}}"
        bind:select="goDetail"
      />
    </block>
    <empty-state wx:elif="{{!timelineLoading}}" text="该人物暂无相关日志" />
  </view>
</view>
