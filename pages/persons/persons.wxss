.persons {
  min-height: 100vh;
  padding: 20rpx 0 40rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin: 0 24rpx 20rpx;
  padding: 0 24rpx;
  background: var(--card);
  border-radius: var(--radius-pill);
}

/* 放大镜：SVG 自身已是灰色，不再叠加 opacity；不参与伸缩以免被输入框挤扁 */
.search-glyph {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.person-scroll {
  white-space: nowrap;
  padding: 0 16rpx;
}

.person-card {
  display: inline-block;
  width: 160rpx;
  padding: 24rpx 12rpx;
  margin: 0 8rpx;
  text-align: center;
  background: var(--card);
  border-radius: var(--radius);
  border: 2rpx solid transparent;
}

.person-card.active {
  border-color: var(--accent);
  background: var(--accent-weak);
}

.p-avatar {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--accent);
  color: var(--text-inv);
  font-size: 34rpx;
}

.p-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.p-count {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.tl {
  margin-top: 24rpx;
}

.tl-head {
  display: flex;
  align-items: baseline;
  /* 与下方 event-card 的 24rpx 左右缘对齐 */
  padding: 0 24rpx 12rpx;
}

.tl-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--accent);
}

.tl-total {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.chips {
  white-space: nowrap;
  padding: 0 24rpx 16rpx;
}

.chip {
  display: inline-block;
  padding: 8rpx 26rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  background: var(--card);
  color: var(--text-2);
}

.chip.active {
  background: var(--accent);
  color: var(--text-inv);
}

.tl event-card {
  display: block;
  margin-bottom: 20rpx;
}