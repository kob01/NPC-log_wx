/* ==================== 全局样式 ==================== */
page {
  /* ---------- 语义色 token（浅色）：组件与页面统一引用，深色模式在下方重定义 ---------- */
  /* 背景与表面 */
  --bg: #f5f6f8;
  --card: #fff;
  --card-sub: #f7f8fa;
  --fill: #f0f0f0;
  --fill-2: #f2f3f5;
  --info-bg: #f0f7ff;
  --mask: rgba(0, 0, 0, 0.5);
  --shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);

  /* 文字 */
  --text-1: #1f1f1f;
  --text-body: #333;
  --text-2: #666;
  --text-3: #999;
  --text-4: #bbb;
  --text-inv: #fff;

  /* 主题与强调 */
  --primary: #1677ff;
  --primary-2: #4096ff;
  --primary-weak: #e6f4ff;
  --accent: #722ed1;
  --accent-weak: #f9f0ff;

  /* 边框与分隔 */
  --border: #eee;
  --border-2: #e3e6eb;
  --divider: #f0f0f0;

  /* 状态色 */
  --danger: #f5222d;
  --danger-weak: #fff1f0;
  --success: #52c41a;
  --warning: #fa8c16;

  /* 标签配色（浅底 + 深字） */
  --tag-blue-bg: #e6f4ff;
  --tag-blue-fg: #1677ff;
  --tag-purple-bg: #f9f0ff;
  --tag-purple-fg: #722ed1;
  --tag-geek-bg: #f0f5ff;
  --tag-geek-fg: #2f54eb;
  --tag-cyan-bg: #e6fffb;
  --tag-cyan-fg: #13c2c2;
  --tag-gold-bg: #fffbe6;
  --tag-gold-fg: #d48806;
  --tag-green-bg: #f6ffed;
  --tag-green-fg: #52c41a;
  --tag-orange-bg: #fff7e6;
  --tag-orange-fg: #fa8c16;
  --tag-red-bg: #fff1f0;
  --tag-red-fg: #f5222d;
  --tag-gray-bg: #f0f0f0;
  --tag-gray-fg: #555;

  background: var(--bg);
  color: var(--text-1);
  font-size: 28rpx;
  line-height: 1.6;
}

/* ---------- 深色模式 token：挂在页面根节点 .theme-dark 类上，由 JS 监听系统切换实时增删，免重进即时换色 ---------- */
.theme-dark {
    --bg: #17181a;
    --card: #232527;
    --card-sub: #2a2c2f;
    --fill: #2f3134;
    --fill-2: #34363a;
    --info-bg: #1c2a3a;
    --mask: rgba(0, 0, 0, 0.65);
    --shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.4);

    --text-1: #eaeaea;
    --text-body: #d0d0d0;
    --text-2: #a6a6a6;
    --text-3: #8a8a8a;
    --text-4: #6a6a6a;
    --text-inv: #fff;

    --primary: #3d8bfd;
    --primary-2: #5b9dff;
    --primary-weak: #17304d;
    --accent: #9f5fe0;
    --accent-weak: #2a1c3d;

    --border: #34363a;
    --border-2: #3a3d42;
    --divider: #303236;

    --danger: #ff6b6b;
    --danger-weak: #3a1e20;
    --success: #73d13d;
    --warning: #ffa940;

    --tag-blue-bg: #17304d;
    --tag-blue-fg: #69b1ff;
    --tag-purple-bg: #2a1c3d;
    --tag-purple-fg: #b37feb;
    --tag-geek-bg: #1b2340;
    --tag-geek-fg: #85a5ff;
    --tag-cyan-bg: #123134;
    --tag-cyan-fg: #36cfc9;
    --tag-gold-bg: #3a2f14;
    --tag-gold-fg: #e8c451;
    --tag-green-bg: #1d2b17;
    --tag-green-fg: #95de64;
    --tag-orange-bg: #3a2716;
    --tag-orange-fg: #ffc069;
    --tag-red-bg: #3a1e20;
    --tag-red-fg: #ff7875;
    --tag-gray-bg: #34363a;
    --tag-gray-fg: #b0b0b0;
}

/* 页面根节点：铺满视口并引用主题 token；根节点带 .theme-dark 时其下所有 token 自动切换 */
.page-root {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text-1);
}

view,
text,
image {
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: var(--shadow);
}

.card-flat {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ellipsis-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 14rpx;
  margin: 0 8rpx 8rpx 0;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  background: var(--tag-gray-bg);
  color: var(--tag-gray-fg);
}

.tag-blue {
  background: var(--tag-blue-bg);
  color: var(--tag-blue-fg);
}

.tag-purple {
  background: var(--tag-purple-bg);
  color: var(--tag-purple-fg);
}

.tag-geekblue {
  background: var(--tag-geek-bg);
  color: var(--tag-geek-fg);
}

.tag-cyan {
  background: var(--tag-cyan-bg);
  color: var(--tag-cyan-fg);
}

.tag-gold {
  background: var(--tag-gold-bg);
  color: var(--tag-gold-fg);
}

.tag-green {
  background: var(--tag-green-bg);
  color: var(--tag-green-fg);
}

.tag-orange {
  background: var(--tag-orange-bg);
  color: var(--tag-orange-fg);
}

.tag-red {
  background: var(--tag-red-bg);
  color: var(--tag-red-fg);
}

/* 次要文本 */
.text-2 {
  color: var(--text-2);
}

.text-3 {
  color: var(--text-3);
}

.text-sm {
  font-size: 24rpx;
}

.text-bold {
  font-weight: 600;
}

/* flex 工具 */
.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

/* 主按钮 */
.btn-primary {
  background: var(--primary);
  color: var(--text-inv);
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.6;
  color: var(--text-inv);
}

.btn-ghost {
  background: var(--card);
  color: var(--primary);
  border: 1rpx solid var(--primary);
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
  text-align: center;
}

/* 提示条（AI 未配置等降级场景） */
.hint-bar {
  background: var(--fill);
  color: var(--text-2);
  font-size: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  line-height: 1.5;
}

/* 顶部分类筛选 chips */
.chips {
  white-space: nowrap;
}

.chip {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: var(--card);
  color: var(--text-2);
}

.chip.active {
  background: var(--primary);
  color: var(--text-inv);
}

/* 分割 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 16rpx 0;
}
