<view class="ec-card" bindtap="onTap">
  <!-- 自己的日志：贴卡片左边缘的主题蓝小竖条。绝对定位不占流，
       标题仍与正文左对齐，他人卡不渲染也不影响任何位置 -->
  <view class="ec-mine-bar" wx:if="{{showMineBar}}"></view>

  <!-- 顶栏：事件标题贴左，时间贴右 -->
  <view class="ec-head">
    <view class="ec-title ellipsis">{{entry.event || '（无标题）'}}</view>
    <text class="ec-time">{{displayTime}}</text>
  </view>

  <!-- 正文 + 单图预览：文字铺满左侧，图片靠右；无图时文字占满整行 -->
  <view class="ec-media">
    <view class="ec-body ellipsis-2" wx:if="{{bodyText}}">{{bodyText}}</view>
    <image
      class="ec-thumb"
      wx:if="{{displayThumbs.length}}"
      src="{{displayThumbs[0]}}"
      mode="aspectFill"
      lazy-load
      data-index="{{0}}"
      catchtap="onPreview"
    />
  </view>

  <view class="ec-tags" wx:if="{{displayTags.length || displayPersons.length}}">
    <view class="tag tag-geekblue" wx:for="{{displayTags}}" wx:key="*this">{{item}}</view>
    <view class="tag tag-purple" wx:for="{{displayPersons}}" wx:key="*this">{{item}}</view>
  </view>

  <!-- 底栏：事件类型固定左下，归属作者 + 地址固定右下靠右；各自有则展示、无则隐藏，左右位置恒定 -->
  <view class="ec-foot" wx:if="{{entry.position || entry.address || entry.author || entry.type || (showScore && scorePercent != null)}}">
    <view class="ec-foot-left">
      <view class="tag tag-blue ec-type" wx:if="{{entry.type}}">{{entry.type}}</view>
      <text class="ec-score" wx:if="{{showScore && scorePercent != null}}">相关度 {{scorePercent}}%</text>
    </view>
    <view class="ec-foot-right">
      <text class="ec-author" wx:if="{{entry.author}}">{{entry.author}}</text>
      <view class="ec-loc ellipsis" wx:if="{{entry.position || entry.address}}">
        <text class="ec-loc-icon">@</text>
        <text>{{entry.position || entry.address}}</text>
      </view>
    </view>
  </view>
</view>
