.ec-card {
  /* 小竖条以卡片为定位基准 */
  position: relative;
  background: var(--card);
  border-radius: var(--radius);
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: var(--shadow);
}

/* 自己的日志标记：贴卡片左边缘的主题蓝小竖条。不占流，标题/正文左边缘位置不变 */
.ec-mine-bar {
  position: absolute;
  left: 0;
  /* 卡片 padding-top 24rpx + 首行行盒中线 22.4rpx（28rpx × 1.6）− 半条高 15rpx，
     让竖条压在首行标题文字的垂直中轴上 */
  top: 31rpx;
  width: 6rpx;
  height: 30rpx;
  /* 左侧不做圆角：贴边时圆角会在卡片边缘露出一截浅色缺口；右侧取宽 6rpx 的一半，写成胶囊变量会被拉成整宽圆弧 */
  border-radius: 0 3rpx 3rpx 0;
  background: var(--primary);
}

/* 顶栏：标题贴左，时间贴右 */
.ec-head {
  display: flex;
  align-items: self-start;
  margin-top: 0;
}

.ec-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.ec-time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 正文 + 单图预览：文字铺满左侧，图片靠右 */
.ec-media {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
}

.ec-body {
  flex: 1;
  min-width: 0;
  /* 图文间距挂在正文右侧：正文缺席时不会给图片留下多余偏移 */
  margin-right: 12rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

/* 单图预览：固定尺寸，margin-left:auto 保证“只有图、无正文”时也贴右 */
.ec-thumb {
  flex-shrink: 0;
  margin-left: auto;
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius);
  background: var(--fill);
}

.ec-tags {
  margin-top: 14rpx;
}

/* 底栏：事件类型固定左下，作者 + 地址固定右下靠右 */
.ec-foot {
  margin-top: 12rpx;
  display: flex;
  align-items: self-end;
}

/* 左下槽：事件类型 + 相关度（不参与伸缩，始终贴左） */
.ec-foot-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* 右下槽：归属作者 + 地址整组贴右（margin-left:auto 保证无左槽内容时也不跑位） */
.ec-foot-right {
  display: flex;
  align-items: center;
  margin-left: auto;
  min-width: 0;
}

/* 归属作者：主题蓝标出「不是本人写的」，与灰字地址分主次；名字不参与伸缩，过长自己省略 */
.ec-author {
  flex-shrink: 0;
  max-width: 200rpx;
  margin-right: 12rpx;
  font-size: 22rpx;
  color: var(--primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 右下地址：过长则省略号截断 */
.ec-loc {
  font-size: 22rpx;
  color: var(--text-3);
  min-width: 0;
}

.ec-loc-icon {
  margin-right: 4rpx;
  color: var(--text-4);
}

/* 事件类型：左下角首个元素，无外边距 */
.ec-type {
  flex-shrink: 0;
  margin: 0;
}

.ec-score {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--primary);
}