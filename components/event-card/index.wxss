.ec-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.ec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.ec-time {
  font-size: 22rpx;
  color: #999;
}

.ec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f1f1f;
}

.ec-body {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.ec-thumbs {
  margin-top: 16rpx;
  white-space: nowrap;
}

.ec-thumb {
  display: inline-block;
  width: 112rpx;
  height: 112rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
  background: #f0f0f0;
}

.ec-tags {
  margin-top: 14rpx;
}

.ec-foot {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ec-loc {
  font-size: 22rpx;
  color: #999;
  max-width: 70%;
}

.ec-loc-icon {
  margin-right: 4rpx;
  color: #bbb;
}

.ec-score {
  font-size: 22rpx;
  color: #1677ff;
}
