<view class="sp-mask" wx:if="{{visible}}">
  <view class="sp-panel">
    <view class="sp-head">
      <text class="sp-title">生成分享卡</text>
      <text class="sp-close" bindtap="onClose">✕</text>
    </view>

    <view class="sp-platforms">
      <view
        wx:for="{{platforms}}"
        wx:key="key"
        class="sp-chip {{index > 0 ? 'sp-chip-left' : ''}} {{platform === item.key ? 'sp-chip-on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onPickPlatform"
      >{{item.label}}</view>
    </view>

    <canvas
      type="2d"
      id="poster"
      class="sp-canvas"
      style="height: {{canvasH}}rpx"
    ></canvas>

    <view wx:if="{{tip}}" class="sp-tip">{{tip}}</view>

    <view class="sp-actions">
      <button class="sp-btn sp-btn-primary" size="mini" bindtap="onShareWx">发给微信好友</button>
      <button class="sp-btn sp-btn-left" size="mini" bindtap="onSave">存到相册</button>
    </view>
    <view class="sp-actions sp-actions-sub">
      <button class="sp-btn" size="mini" bindtap="onShareToApp" data-platform="xiaohongshu">去小红书发布</button>
      <button class="sp-btn sp-btn-left" size="mini" bindtap="onShareToApp" data-platform="douyin">去抖音发布</button>
    </view>
    <view class="sp-actions sp-actions-sub">
      <button class="sp-btn" size="mini" bindtap="onRegenerate">换一版文案</button>
      <button class="sp-btn sp-btn-left" size="mini" bindtap="onCopyText">复制文案</button>
    </view>
  </view>
</view>
